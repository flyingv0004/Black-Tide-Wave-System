int OnInit() {
   handleEMA = iMA(_Symbol, _Period, InpEMAPeriod, 0, MODE_EMA, PRICE_CLOSE);
   handleMTF = iMA(_Symbol, InpFilterMTF, InpEMAPeriod, 0, MODE_EMA, PRICE_CLOSE);
   handleZZ = iCustom(_Symbol, _Period, "Examples\\ZigZag", InpZZDepth, InpZZDeviation, InpZZBackstep);

   if(handleEMA == INVALID_HANDLE || handleMTF == INVALID_HANDLE || handleZZ == INVALID_HANDLE) return(INIT_FAILED);
   trade.SetExpertMagicNumber(InpMagic);
   
   SyncMTFData();
   UpdateDashboard();
   return(INIT_SUCCEEDED);
}

void OnDeinit(const int reason) {
   ObjectDelete(0, "Line_Upper");
   ObjectDelete(0, "Line_Lower");
   ObjectsDeleteAll(0, "ZZ_");
   ObjectsDeleteAll(0, "ZZLN_"); 
   Comment("");
}

void OnTick() {
   CheckProfitAndSafety();
   SyncMTFData(); 
   UpdateMTFEma();     // [V19.3] อ่านค่า EMA ของ MTF
   CheckMTFCut();      // [V19.3] ตัดออเดอร์เมื่อราคาข้ามเส้น (ทำงานก่อนเช็ค delay)
   ManagePairClose();     // [V19.5] จับคู่ปิดไม้แก้ + เปิดไม้ทดแทน
   CheckPairSetClose();   // [V19.5] ปิดทั้งชุดเมื่อกำไรลอย + กำไรที่ปิดคู่ไปแล้ว ถึงเป้า
   UpdateDashboard();
   
   if(InpShowZigZag) DrawZigZagMarkers();

   // [V19.3] delay หลังตัดด้วย MTF Cut (แยกจาก delay เดิม)
   if(lastCutTime > 0 && TimeCurrent() < lastCutTime + (InpCutDelayMins * 60)) {
      blockStatus = "CUT DELAY ACTIVE (" + (string)InpCutDelayMins + "m)";
      return;
   }

   // --- เช็ค Delay แยกตามระบบ ---
   int currentDelay = isCrossSystemActive ? InpCrossDelayMins : InpDelayMinutes;
   if(lastCloseTime > 0 && TimeCurrent() < lastCloseTime + (currentDelay * 60)) {
      blockStatus = "DELAY ACTIVE (" + (string)currentDelay + "m)";
      return;
   }

   int totalPos = 0;
   double lastOpenPrice = 0, lastOpenLot = 0;
   ENUM_POSITION_TYPE lastType = (ENUM_POSITION_TYPE)-1;

   for(int i = PositionsTotal() - 1; i >= 0; i--) {
      ulong ticket = PositionGetTicket(i);
      if(PositionSelectByTicket(ticket) && PositionGetInteger(POSITION_MAGIC) == InpMagic && PositionGetString(POSITION_SYMBOL) == _Symbol) {
         totalPos++;
         if(lastOpenPrice == 0) {
            lastOpenPrice = PositionGetDouble(POSITION_PRICE_OPEN);
            lastOpenLot   = PositionGetDouble(POSITION_VOLUME);
            lastType      = (ENUM_POSITION_TYPE)PositionGetInteger(POSITION_TYPE);
         }
      }
   }

   ApplyGridAnchor(totalPos, lastOpenPrice, lastOpenLot);   // [V19.5] ใช้จุดอ้างอิงกริดที่เก็บไว้ (ปิดอยู่ = ไม่ทำอะไร)
   datetime currentCandle = iTime(_Symbol, _Period, 0);
   if(lastCandleTime == currentCandle) return; 

   if(totalPos == 0) {
      blockStatus = "READY";
      highestProfitUSD = 0;
      isCrossSystemActive = false; // Reset ระบบ

      if(InpUseMTF && StringFind(mtfStatus, "INITIALIZING") >= 0) {
         blockStatus = "WAITING FOR MTF DATA...";
         return; 
      }

      if(!IsWorkingDay()) { blockStatus = "NON-TRADING DAY"; return; }
      if(IsBreakTime()) { blockStatus = "BREAK TIME"; return; }
      if(IsMTFEmaBlocked()) return;   // [V19.3] บล็อกไม้แรกเมื่อใกล้/คาบเส้น EMA ของ MTF

      double ema[]; ArraySetAsSeries(ema, true);
      if(CopyBuffer(handleEMA, 0, 0, 3, ema) < 3) return;

      double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
      double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
      double close1 = iClose(_Symbol, _Period, 1);
      double open1  = iOpen(_Symbol, _Period, 1);

      // --- [NEW] 1. ระบบ EMA CROSS ENTRY ---
      if(InpUseEMACrossEntry) {
         bool crossCanBuy = true;
         bool crossCanSell = true;
         
         // เช็ค MTF เฉพาะของระบบ Cross ถ้าถูกสั่งให้เปิดใช้
         if(InpCrossUseMTF && InpUseMTF) {
            if(StringFind(mtfStatus, "BUY ONLY") >= 0) crossCanSell = false;
            if(StringFind(mtfStatus, "SELL ONLY") >= 0) crossCanBuy = false;
         }

         if(open1 < ema[1] && close1 > ema[1] && crossCanBuy) { // ตัดขึ้น
            if(trade.Buy(InpLotFirst, _Symbol, ask, 0, 0)) { 
               lastCandleTime = currentCandle; 
               blockStatus = "EMA CROSS: BUY"; 
               isCrossSystemActive = true; 
               return; 
            }
         }
         if(open1 > ema[1] && close1 < ema[1] && crossCanSell) { // ตัดลง
            if(trade.Sell(InpLotFirst, _Symbol, bid, 0, 0)) { 
               lastCandleTime = currentCandle; 
               blockStatus = "EMA CROSS: SELL"; 
               isCrossSystemActive = true; 
               return; 
            }
         }
      }

      // --- 2. ระบบ BREAKOUT เดิม ---
      double upperSource[], lowerSource[];
      ArraySetAsSeries(upperSource, true); ArraySetAsSeries(lowerSource, true);
      if(InpPriceType == PRICE_WICKS) {
         if(CopyHigh(_Symbol, _Period, 0, InpLookback+1, upperSource) < InpLookback+1 || CopyLow(_Symbol, _Period, 0, InpLookback+1, lowerSource) < InpLookback+1) return;
      } else {
         double o[], c[]; ArraySetAsSeries(o, true); ArraySetAsSeries(c, true);
         if(CopyOpen(_Symbol, _Period, 0, InpLookback+1, o) < InpLookback+1 || CopyClose(_Symbol, _Period, 0, InpLookback+1, c) < InpLookback+1) return;
         ArrayResize(upperSource, InpLookback+1); ArrayResize(lowerSource, InpLookback+1);
         for(int i=0; i<=InpLookback; i++) { upperSource[i] = MathMax(o[i], c[i]); lowerSource[i] = MathMin(o[i], c[i]); }
      }

      if(InpFilterEMACross) {
         double h_curr[], l_curr[]; ArraySetAsSeries(h_curr, true); ArraySetAsSeries(l_curr, true);
         CopyHigh(_Symbol, _Period, 0, 2, h_curr); CopyLow(_Symbol, _Period, 0, 2, l_curr);
         if((h_curr[0] >= ema[0] && l_curr[0] <= ema[0]) || (h_curr[1] >= ema[1] && l_curr[1] <= ema[1]) || (ask >= ema[0] && bid <= ema[0])) {
            blockStatus = "BLOCK: Candle Cross EMA";
            return; 
         }
      }

      bool canBuy = true, canSell = true;
      if(InpUseMTF) {
         if(StringFind(mtfStatus, "BUY ONLY") >= 0) canSell = false;
         if(StringFind(mtfStatus, "SELL ONLY") >= 0) canBuy = false;
      }
      if(InpUseStructureFilter) {
         string currentStr = GetCurrentStructure();
         if(canBuy && (currentStr == "LL" || currentStr == "LH")) { canBuy = false; blockStatus = "STRUC BLOCK: BEARISH"; }
         if(canSell && (currentStr == "HH" || currentStr == "HL")) { canSell = false; blockStatus = "STRUC BLOCK: BULLISH"; }
      }

      double maxH = upperSource[ArrayMaximum(upperSource, 1, InpLookback)];
      double minL = lowerSource[ArrayMinimum(lowerSource, 1, InpLookback)];
      DrawLine("Line_Upper", maxH, clrDodgerBlue);
      DrawLine("Line_Lower", minL, clrOrange);

      if(ask > maxH && ask > ema[0] && canBuy) {
         if(trade.Buy(InpLotFirst, _Symbol, ask, 0, 0)) { lastCandleTime = currentCandle; blockStatus = "BUY OPENED"; }
      }
      else if(bid < minL && bid < ema[0] && canSell) {
         if(trade.Sell(InpLotFirst, _Symbol, bid, 0, 0)) { lastCandleTime = currentCandle; blockStatus = "SELL OPENED"; }
      }
   }
   else if(totalPos < InpMaxLevels) {
      // --- ระบบ Martingale (ใช้งานร่วมกันได้ทั้งหมด) ---
      blockStatus = "MARTINGALE ACTIVE (" + (string)totalPos + ")";
      double currentAsk = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
      double currentBid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
      double nextLot = CalculateLot(lastOpenLot);
      
      bool classicSignal = false;
      if(InpUseClassicMarty) {
         if(lastType == POSITION_TYPE_BUY && (lastOpenPrice - currentAsk) >= InpDistanceUSD) classicSignal = true;
         if(lastType == POSITION_TYPE_SELL && (currentBid - lastOpenPrice) >= InpDistanceUSD) classicSignal = true;
      }

      bool hybridSignal = false;
      if(InpUseHybridMarty) {
         double h_high[], h_low[]; ArraySetAsSeries(h_high, true); ArraySetAsSeries(h_low, true);
         if(CopyHigh(_Symbol, _Period, 1, InpHybridLookback, h_high) > 0 && CopyLow(_Symbol, _Period, 1, InpHybridLookback, h_low) > 0) {
            double currentMin = h_low[ArrayMinimum(h_low)];
            double currentMax = h_high[ArrayMaximum(h_high)];
            if(lastType == POSITION_TYPE_BUY && (lastOpenPrice - currentAsk) >= InpHybridMinDistUSD && currentAsk <= currentMin) hybridSignal = true;
            if(lastType == POSITION_TYPE_SELL && (currentBid - lastOpenPrice) >= InpHybridMinDistUSD && currentBid >= currentMax) hybridSignal = true;
         }
      }

      if(classicSignal || hybridSignal) {
         if(CheckMarginSafe(nextLot, lastType)) {
            if(lastType == POSITION_TYPE_BUY) { if(trade.Buy(nextLot, _Symbol, currentAsk, 0, 0)) lastCandleTime = currentCandle; }
            else if(lastType == POSITION_TYPE_SELL) { if(trade.Sell(nextLot, _Symbol, currentBid, 0, 0)) lastCandleTime = currentCandle; }
         } else { blockStatus = "MARGIN LIMIT REACHED"; }
      }
   }
}

// --- ฟังก์ชันกำไรรวมของบัญชีวันนี้ ---
double GetAccountTodayProfit() {
   double total = 0;
   datetime start = iTime(_Symbol, PERIOD_D1, 0);
   if(HistorySelect(start, TimeCurrent())) {
      int totalDeals = HistoryDealsTotal();
      for(int i = 0; i < totalDeals; i++) {
         ulong ticket = HistoryDealGetTicket(i);
         if(ticket > 0) total += HistoryDealGetDouble(ticket, DEAL_PROFIT) + HistoryDealGetDouble(ticket, DEAL_COMMISSION) + HistoryDealGetDouble(ticket, DEAL_SWAP);
      }
   }
   return NormalizeDouble(total, 2);
}

// --- ฟังก์ชันกำไรของบอทตัวนี้วันนี้ ---
double GetBotTodayProfit() {
   double total = 0;
   datetime start = iTime(_Symbol, PERIOD_D1, 0);
   if(HistorySelect(start, TimeCurrent())) {
      int totalDeals = HistoryDealsTotal();
      for(int i = 0; i < totalDeals; i++) {
         ulong ticket = HistoryDealGetTicket(i);
         if(ticket > 0 && HistoryDealGetInteger(ticket, DEAL_MAGIC) == InpMagic) {
            total += HistoryDealGetDouble(ticket, DEAL_PROFIT) + HistoryDealGetDouble(ticket, DEAL_COMMISSION) + HistoryDealGetDouble(ticket, DEAL_SWAP);
         }
      }
   }
   return NormalizeDouble(total, 2);
}

// --- ฟังก์ชันดึงโครงสร้างราคาล่าสุด ---
string GetCurrentStructure() {
   double zz[]; ArraySetAsSeries(zz, true);
   if(CopyBuffer(handleZZ, 0, 0, 250, zz) <= 0) return "UNKNOWN";
   double lastH = 0, prevH = 0, lastL = 0, prevL = 0; int hCount = 0, lCount = 0;
   for(int i = 0; i < 250; i++) {
      if(zz[i] > 0) {
         bool isPeak = (MathAbs(iHigh(_Symbol, _Period, i) - zz[i]) < _Point * 10);
         if(isPeak) { if(hCount == 0) lastH = zz[i]; else if(hCount == 1) prevH = zz[i]; hCount++; }
         else { if(lCount == 0) lastL = zz[i]; else if(lCount == 1) prevL = zz[i]; lCount++; }
      }
      if(hCount >= 2 && lCount >= 2) break;
   }
   if(hCount < 2 || lCount < 2) return "NEUTRAL";
   if(lastH > prevH && lastL >= prevL) return "HH"; 
   if(lastL < prevL && lastH <= prevH) return "LL";
   if(lastH < prevH && lastL > prevL) return "LH"; 
   if(lastH > prevH && lastL < prevL) return "HL"; 
   return "TRANSITION";
}

void DrawZigZagMarkers() {
   double zzBuffer[]; ArraySetAsSeries(zzBuffer, true);
   if(CopyBuffer(handleZZ, 0, 0, 300, zzBuffer) <= 0) return;
   ObjectsDeleteAll(0, "ZZ_"); ObjectsDeleteAll(0, "ZZLN_"); 
   double lastH = 0, lastL = 0, currP = 0, prevP = 0; int lineCount = 0; datetime currT = 0, prevT = 0;
   for(int i = 250; i >= 0; i--) { 
      if(zzBuffer[i] > 0) {
         double val = zzBuffer[i]; datetime time = iTime(_Symbol, _Period, i); string label = ""; color clr = clrGray;
         bool isPeak = (MathAbs(iHigh(_Symbol, _Period, i) - val) < _Point * 10);
         if(isPeak) { if(lastH > 0) { label = (val > lastH) ? "HH" : "LH"; clr = (val > lastH) ? clrLime : clrRed; } else label = "H"; lastH = val; }
         else { if(lastL > 0) { label = (val > lastL) ? "HL" : "LL"; clr = (val > lastL) ? clrLime : clrRed; } else label = "L"; lastL = val; }
         string name = "ZZ_" + (string)time;
         if(ObjectCreate(0, name, OBJ_TEXT, 0, time, val)) { ObjectSetString(0, name, OBJPROP_TEXT, label); ObjectSetInteger(0, name, OBJPROP_COLOR, clr); ObjectSetInteger(0, name, OBJPROP_ANCHOR, isPeak ? ANCHOR_BOTTOM : ANCHOR_TOP); }
         prevP = currP; prevT = currT; currP = val; currT = time;
         if(prevP > 0) { string ln = "ZZLN_" + (string)lineCount++; ObjectCreate(0, ln, OBJ_TREND, 0, currT, currP, prevT, prevP); ObjectSetInteger(0, ln, OBJPROP_RAY_RIGHT, false); ObjectSetInteger(0, ln, OBJPROP_STYLE, STYLE_DOT); }
      }
   }
}

bool CheckMarginSafe(double lot, ENUM_POSITION_TYPE type) {
   double margin; ENUM_ORDER_TYPE ot = (type == POSITION_TYPE_BUY) ? ORDER_TYPE_BUY : ORDER_TYPE_SELL;
   if(!OrderCalcMargin(ot, _Symbol, lot, SymbolInfoDouble(_Symbol, SYMBOL_ASK), margin)) return false;
   return (AccountInfoDouble(ACCOUNT_MARGIN_FREE) > margin);
}

void SyncMTFData() {
   if(!InpUseMTF) { mtfStatus = "MTF: OFF"; return; }
   double mtfEMA[], mtfClose[]; ArraySetAsSeries(mtfEMA, true); ArraySetAsSeries(mtfClose, true);
   if(CopyBuffer(handleMTF, 0, 0, 1, mtfEMA) > 0 && CopyClose(_Symbol, InpFilterMTF, 0, 1, mtfClose) > 0) {
      if(mtfClose[0] > mtfEMA[0]) mtfStatus = "MTF [" + EnumToString(InpFilterMTF) + "]: BUY ONLY";
      else if(mtfClose[0] < mtfEMA[0]) mtfStatus = "MTF [" + EnumToString(InpFilterMTF) + "]: SELL ONLY";
      else mtfStatus = "MTF [" + EnumToString(InpFilterMTF) + "]: NEUTRAL";
   } else mtfStatus = "MTF: INITIALIZING...";
}

void CheckProfitAndSafety() {
   double totalProfitUSD = 0; int count = 0;
   double balance = AccountInfoDouble(ACCOUNT_BALANCE);
   for(int i = PositionsTotal() - 1; i >= 0; i--) {
      if(PositionSelectByTicket(PositionGetTicket(i)) && PositionGetInteger(POSITION_MAGIC) == InpMagic && PositionGetString(POSITION_SYMBOL) == _Symbol) {
         totalProfitUSD += PositionGetDouble(POSITION_PROFIT) + PositionGetDouble(POSITION_SWAP);
         count++;
      }
   }
   if(count == 0) return;

   double currentTarget = isCrossSystemActive ? InpCrossTargetUSD : InpTargetProfitUSD;

   if(InpUseMaxDD && ((totalProfitUSD / balance) * 100.0) <= -MathAbs(InpMaxDrawdownPct)) CloseAllPositions();
   if(totalProfitUSD >= currentTarget) { CloseAllPositions(); lastCloseTime = TimeCurrent(); return; }
   if(InpUseTrailing) {
      if(totalProfitUSD > highestProfitUSD) highestProfitUSD = totalProfitUSD;
      if(highestProfitUSD >= InpTrailingStartUSD && totalProfitUSD <= (highestProfitUSD - InpTrailingStepUSD)) { CloseAllPositions(); lastCloseTime = TimeCurrent(); highestProfitUSD = 0; }
   }
}

