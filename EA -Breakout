bool IsBreakTime() {
   if(!InpUseBreakTime) return false;
   MqlDateTime dt; TimeToStruct(TimeCurrent(), dt); int currM = dt.hour * 60 + dt.min;
   string breaks[4] = {InpBreak1, InpBreak2, InpBreak3, InpBreak4};
   for(int i=0; i<4; i++) {
      if(breaks[i] == "" || StringLen(breaks[i]) < 5) continue;
      string pts[]; if(StringSplit(breaks[i], '-', pts) == 2) {
         string s_p[], e_p[]; if(StringSplit(pts[0], ':', s_p) == 2 && StringSplit(pts[1], ':', e_p) == 2) {
            int start = (int)StringToInteger(s_p[0])*60 + (int)StringToInteger(s_p[1]);
            int end   = (int)StringToInteger(e_p[0])*60 + (int)StringToInteger(e_p[1]);
            if(start < end) { if(currM >= start && currM <= end) return true; }
            else { if(currM >= start || currM <= end) return true; }
         }
      }
   }
   return false;
}

bool IsWorkingDay() {
   MqlDateTime dt; TimeCurrent(dt);
   if(dt.day_of_week == 1 && !InpTradeMonday) return false;
   if(dt.day_of_week == 2 && !InpTradeTuesday) return false;
   if(dt.day_of_week == 3 && !InpTradeWednesday) return false;
   if(dt.day_of_week == 4 && !InpTradeThursday) return false;
   if(dt.day_of_week == 5 && !InpTradeFriday) return false;
   return true;
}

void CloseAllPositions() {
   for(int i = PositionsTotal() - 1; i >= 0; i--) {
      ulong t = PositionGetTicket(i); if(PositionSelectByTicket(t) && PositionGetInteger(POSITION_MAGIC) == InpMagic) trade.PositionClose(t);
   }
}

double CalculateLot(double lastLot) {
   double n = lastLot * InpLotMultiplier, s = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP);
   return NormalizeDouble(MathMin(MathMax(MathCeil(n/s)*s, SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN)), SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MAX)), 2);
}

