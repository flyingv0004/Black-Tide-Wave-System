//| [V19.5] Pair-Close: จับคู่ปิดไม้แก้ + เปิดไม้ทดแทน (กริดไม่ขยับ)    |
//| จับ "ไม้ใหม่สุด" กับ "ไม้ที่ P/L ดีที่สุดในไม้ที่เหลือ" ปิดคู่เมื่อ    |
//| กำไรรวมถึงเป้า แล้วเปิดไม้ทดแทน lot เท่าไม้ใหม่สุดที่ราคาปัจจุบัน    |
//| ไม้ทดแทนติดคอมเมนต์ "BB-PC" เพื่อแยกจากไม้ชั้นของกริด               |
//| จุดอ้างอิงกริดเก็บแยกไว้ (ราคา/lot ของชั้นล่าสุดจริง) ไม่ขยับตามไม้ทดแทน|
//+------------------------------------------------------------------+
string PcKey(string n) { return "BBPC_" + (string)InpMagic + "_" + _Symbol + "_" + n; }

void PcSave() {
   GlobalVariableSet(PcKey("real"),  pcRealized);
   GlobalVariableSet(PcKey("extra"), (double)pcExtra);
   GlobalVariableSet(PcKey("ancT"),  (double)pcAnchorMsc);
   GlobalVariableSet(PcKey("ancP"),  pcAnchorPrice);
   GlobalVariableSet(PcKey("ancL"),  pcAnchorLot);
}

void PcClear() {
   pcRealized = 0; pcExtra = 0; pcAnchorMsc = 0; pcAnchorPrice = 0; pcAnchorLot = 0;
   GlobalVariableDel(PcKey("real"));  GlobalVariableDel(PcKey("extra"));
   GlobalVariableDel(PcKey("ancT"));  GlobalVariableDel(PcKey("ancP")); GlobalVariableDel(PcKey("ancL"));
}

// โหลดสถานะครั้งแรก (ทนต่อการโหลด EA ใหม่/รีสตาร์ทเทอร์มินัล)
void PcLoad() {
   if(pcLoaded) return;
   pcLoaded = true;
   if(GlobalVariableCheck(PcKey("ancT"))) {
      pcAnchorMsc   = (long)GlobalVariableGet(PcKey("ancT"));
      pcAnchorPrice = GlobalVariableGet(PcKey("ancP"));
      pcAnchorLot   = GlobalVariableGet(PcKey("ancL"));
   }
   if(GlobalVariableCheck(PcKey("real")))  pcRealized = GlobalVariableGet(PcKey("real"));
   if(GlobalVariableCheck(PcKey("extra"))) pcExtra    = (int)GlobalVariableGet(PcKey("extra"));
}

// Print แบบจำกัดความถี่ (อย่างน้อย 60 วินาทีต่อครั้ง) กัน log ท่วมกรณีล้มเหลวซ้ำ
void PcPrintThrottled(string msg) {
   static datetime lastPrint = 0;
   if(TimeCurrent() - lastPrint < 60) return;
   lastPrint = TimeCurrent();
   Print(msg);
}

// อัปเดตจุดอ้างอิงกริดจาก "ไม้ล่าสุดที่ไม่ใช่ไม้ทดแทน" ถ้ามีชั้นใหม่เปิดหลังจุดที่เก็บไว้
void PcSyncAnchor() {
   long bestMsc = 0; double bp = 0, bl = 0;
   for(int i = PositionsTotal() - 1; i >= 0; i--) {
      ulong t = PositionGetTicket(i);
      if(!PositionSelectByTicket(t)) continue;
      if(PositionGetInteger(POSITION_MAGIC) != InpMagic || PositionGetString(POSITION_SYMBOL) != _Symbol) continue;
      if(StringFind(PositionGetString(POSITION_COMMENT), "BB-PC") >= 0) continue;   // ข้ามไม้ทดแทน
      long m = PositionGetInteger(POSITION_TIME_MSC);
      if(m > bestMsc) { bestMsc = m; bp = PositionGetDouble(POSITION_PRICE_OPEN); bl = PositionGetDouble(POSITION_VOLUME); }
   }
   if(bestMsc > pcAnchorMsc) {
      pcAnchorMsc = bestMsc; pcAnchorPrice = bp; pcAnchorLot = bl;
      PcSave();
   }
}

// บรรทัดเดียวที่แทรกในส่วน Martingale เดิมเรียกตัวนี้: แทนค่า "ไม้ล่าสุด" ด้วยจุดอ้างอิงกริด
void ApplyGridAnchor(int &totalPos, double &lastPrice, double &lastLot) {
   if(!InpUsePairClose) return;
   PcLoad();
   if(InpPairMode != PAIR_REPLACE_FIXED_GRID) {   // โหมดไม่เปิดทดแทน: ปล่อยให้โค้ดเดิมใช้ไม้ล่าสุดจริง
      if(pcAnchorMsc != 0 || pcExtra != 0) { pcAnchorMsc = 0; pcAnchorPrice = 0; pcAnchorLot = 0; pcExtra = 0; PcSave(); }
      return;
   }
   if(totalPos == 0) {
      if(pcAnchorMsc != 0 || pcRealized != 0 || pcExtra != 0) PcClear();
      return;
   }
   PcSyncAnchor();
   if(pcAnchorMsc == 0) return;
   lastPrice = pcAnchorPrice;   // ระยะ Classic/Hybrid และ lot ถัดไปนับจากชั้นล่าสุดของกริด
   lastLot   = pcAnchorLot;
   totalPos += pcExtra;         // นับเป็นจำนวนชั้นกริด เพื่อให้ InpMaxLevels ยังคุมได้เหมือนเดิม
}

void ManagePairClose() {
   if(!InpUsePairClose || mtfCutPending) return;
   PcLoad();

   // นับไม้ + หาไม้ใหม่สุด (ตามเวลาเปิดละเอียดระดับ ms)
   int count = 0; ulong newest = 0; long newestMsc = 0;
   for(int i = PositionsTotal() - 1; i >= 0; i--) {
      ulong t = PositionGetTicket(i);
      if(!PositionSelectByTicket(t)) continue;
      if(PositionGetInteger(POSITION_MAGIC) != InpMagic || PositionGetString(POSITION_SYMBOL) != _Symbol) continue;
      count++;
      long m = PositionGetInteger(POSITION_TIME_MSC);
      if(newest == 0 || m > newestMsc) { newest = t; newestMsc = m; }
   }
   if(count < MathMax(2, InpPairStartCount)) return;

   const bool grid = (InpPairMode == PAIR_REPLACE_FIXED_GRID);
   if(grid) PcSyncAnchor();   // กันกรณีไม้ชั้นใหม่เพิ่งเปิดแล้วถูกจับคู่ปิดก่อนบันทึกจุดอ้างอิง

   if(!PositionSelectByTicket(newest)) return;
   double newestProfit = PositionGetDouble(POSITION_PROFIT) + PositionGetDouble(POSITION_SWAP);
   double newestVol    = PositionGetDouble(POSITION_VOLUME);
   ENUM_POSITION_TYPE type = (ENUM_POSITION_TYPE)PositionGetInteger(POSITION_TYPE);

   if(InpUsePairMaxLot && InpPairMaxLot > 0 && newestVol > InpPairMaxLot) return;
   if(newestVol > SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MAX)) return;

   // ไม้ที่ P/L ดีที่สุดในบรรดาไม้ที่เหลือ (ไม่รวมไม้ใหม่สุด)
   ulong best = 0; double bestProfit = 0; bool found = false;
   for(int i = PositionsTotal() - 1; i >= 0; i--) {
      ulong t = PositionGetTicket(i);
      if(t == newest || !PositionSelectByTicket(t)) continue;
      if(PositionGetInteger(POSITION_MAGIC) != InpMagic || PositionGetString(POSITION_SYMBOL) != _Symbol) continue;
      double p = PositionGetDouble(POSITION_PROFIT) + PositionGetDouble(POSITION_SWAP);
      if(!found || p > bestProfit) { best = t; bestProfit = p; found = true; }
   }
   if(!found) return;

   double pairProfit = newestProfit + bestProfit;
   if(pairProfit < InpPairProfitUSD) return;

   // ปิดคู่ แล้วเช็คผลทีละไม้ (บันทึกเฉพาะไม้ที่ปิดสำเร็จจริง)
   bool okBest = trade.PositionClose(best);
   bool okNew  = trade.PositionClose(newest);
   if(okBest) { pcRealized += bestProfit;   if(grid) pcExtra++; }
   if(okNew)  { pcRealized += newestProfit; if(grid) pcExtra++; }
   if(!okBest || !okNew) {
      PcSave();
      PcPrintThrottled("PAIR-CLOSE ปิดไม่สำเร็จบางไม้: best#" + (string)best + "(" + (okBest ? "OK" : "FAIL") + ") newest#" +
                       (string)newest + "(" + (okNew ? "OK" : "FAIL") + ") ret=" + (string)(int)trade.ResultRetcode() +
                       " — ข้ามการเปิดไม้ทดแทน รอ tick ถัดไป");
      return;
   }

   // เปิดไม้ทดแทน (เฉพาะโหมดเปิดทดแทน): lot เท่าไม้ใหม่สุดที่ปิดไป ที่ราคาปัจจุบัน (เช็ค margin ก่อน)
   bool replaced = false;
   if(grid && CheckMarginSafe(newestVol, type)) {
      if(type == POSITION_TYPE_BUY) replaced = trade.Buy(newestVol, _Symbol, SymbolInfoDouble(_Symbol, SYMBOL_ASK), 0, 0, "BB-PC");
      else                          replaced = trade.Sell(newestVol, _Symbol, SymbolInfoDouble(_Symbol, SYMBOL_BID), 0, 0, "BB-PC");
   }
   if(replaced) pcExtra--;   // ปิด 2 เปิด 1 = จำนวนไม้ลด 1 ชั้นกริดไม่ลด
   PcSave();

   PrintFormat("PAIR-CLOSE %s: newest#%s (%.2f lot) + best#%s | pair profit=%.2f | realized total=%.2f | replacement=%s",
               (type == POSITION_TYPE_BUY ? "BUY" : "SELL"), (string)newest, newestVol, (string)best,
               pairProfit, pcRealized, (replaced ? "OPENED" : (grid ? "NO" : "OFF")));
}

// ปิดทั้งชุดเมื่อ กำไรลอยตัว + กำไรที่ปิดคู่ไปแล้ว >= เป้า (ไม่แก้ฟังก์ชันเช็คเป้าเดิม)
void CheckPairSetClose() {
   if(!InpUsePairClose) return;
   PcLoad();

   int count = 0; double floating = 0;
   for(int i = PositionsTotal() - 1; i >= 0; i--) {
      ulong t = PositionGetTicket(i);
      if(!PositionSelectByTicket(t)) continue;
      if(PositionGetInteger(POSITION_MAGIC) != InpMagic || PositionGetString(POSITION_SYMBOL) != _Symbol) continue;
      count++;
      floating += PositionGetDouble(POSITION_PROFIT) + PositionGetDouble(POSITION_SWAP);
   }
   if(count == 0) {
      if(pcAnchorMsc != 0 || pcRealized != 0 || pcExtra != 0) PcClear();   // ชุดจบแล้ว รีเซ็ตสถานะ
      return;
   }
   if(pcRealized <= 0) return;

   double target = isCrossSystemActive ? InpCrossTargetUSD : InpTargetProfitUSD;
   if(floating + pcRealized >= target) {
      PcPrintThrottled("PAIR-CLOSE ปิดทั้งชุด: floating=" + DoubleToString(floating, 2) + " + realized=" +
                       DoubleToString(pcRealized, 2) + " >= target=" + DoubleToString(target, 2));
      CloseAllPositions();
      lastCloseTime = TimeCurrent();
      highestProfitUSD = 0;
   }
}
