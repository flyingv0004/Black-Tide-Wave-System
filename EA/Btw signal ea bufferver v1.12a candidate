//+------------------------------------------------------------------+
//| นับจำนวนสัญญาณที่เปิดไม้แรกวันนี้ โดยนับจาก "ประวัติจริง" ของ      |
//| broker (นับ basketId ที่ไม่ซ้ำกันจาก deal ฝั่งเปิดที่มี Magic       |
//| ตรงกัน) แทนการใช้ตัวนับสะสมในหน่วยความจำ เพราะตัวนับในหน่วยความจำ  |
//| จะรีเซ็ตเป็น 0 ทุกครั้งที่ EA reload (ถอด-แนบใหม่/compile ใหม่)     |
//| ทำให้นับไม่ครบถ้า reload ระหว่างวัน วิธีนี้นับจากข้อมูลจริงเสมอ     |
//| แม่นยำไม่ว่าจะ reload กี่ครั้งก็ตาม                                |
//+------------------------------------------------------------------+
int GetDailySignalCountFromHistory(datetime rangeStart, datetime rangeEnd)
  {
   string seenBaskets[];
   int seenCount = 0;

   if(!HistorySelect(rangeStart, rangeEnd))
      return 0;

   int total = HistoryDealsTotal();
   for(int i = 0; i < total; i++)
     {
      ulong ticket = HistoryDealGetTicket(i);
      if(ticket == 0) continue;
      if(HistoryDealGetInteger(ticket, DEAL_MAGIC) != InpMagic) continue;
      if((ENUM_DEAL_ENTRY)HistoryDealGetInteger(ticket, DEAL_ENTRY) != DEAL_ENTRY_IN) continue; // เอาเฉพาะ deal ฝั่งเปิด

      string cmt = HistoryDealGetString(ticket, DEAL_COMMENT);
      int sep = StringFind(cmt, "|");
      string basketId = (sep >= 0) ? StringSubstr(cmt, 0, sep) : cmt;

      bool found = false;
      for(int k = 0; k < seenCount; k++)
        {
         if(seenBaskets[k] == basketId)
           {
            found = true;
            break;
           }
        }
      if(!found)
        {
         ArrayResize(seenBaskets, seenCount + 1);
         seenBaskets[seenCount] = basketId;
         seenCount++;
        }
     }
   return seenCount;
  }

