//| วาด/อัปเดตกล่องสรุปผลประจำวันที่มุมซ้ายล่างของกราฟ                  |
//| หมายเหตุ: OBJ_LABEL ของ MT5 ไม่รองรับข้อความหลายบรรทัดในตัวเดียว   |
//| (ใส่ \n ไปแล้วมันไม่ตัดบรรทัดจริง กลายเป็นเส้นเดียวยาวทะลุขอบจอ)     |
//| จึงต้องสร้าง Label แยกทีละบรรทัดแทน แล้วเรียงตำแหน่ง Y เอง         |
//+------------------------------------------------------------------+
void UpdateDailyDashboard()
  {
   int lineCount = 6;

   if(!InpShowDailyDashboard)
     {
      ObjectDelete(0, DASH_BG_NAME);
      for(int i = 0; i < lineCount; i++)
         ObjectDelete(0, DASH_OBJ_NAME + "_L" + IntegerToString(i));
      return;
     }

   // จำกัดความถี่อัปเดต กันหนักเครื่อง (ทุกประมาณ 2 วินาทีพอ)
   if(GetTickCount() - g_lastDashboardUpdate < 2000)
      return;
   g_lastDashboardUpdate = GetTickCount();

   datetime dayStart, dayEnd;
   // v1.11 (candidate): ใช้ค่าที่ cache ไว้แล้ว (นิ่ง ไม่สั่นตามจิตเตอร์ของนาฬิกาสด)
   // แทนการเรียก GetDayBoundaries() ตรง ๆ
   GetStableDayBoundaries(dayStart, dayEnd);

   double realized = GetRealizedProfitInRange(dayStart, dayEnd);
   double floating = GetFloatingProfitAll();
   double totalToday = realized + floating;

   string tzLabel = InpUseThaiTime ? "Thai Time" : "Server Time";

   string lines[6];
   lines[0] = "BTW Signal EA - Today";
   lines[1] = "(" + tzLabel + ")";
   lines[2] = "P/L: " + DoubleToString(totalToday, 2) + " USD";
   lines[3] = "Closed: " + DoubleToString(realized, 2);
   lines[4] = "Floating: " + DoubleToString(floating, 2);
   lines[5] = "Signals: " + IntegerToString(GetDailySignalCountFromHistory(dayStart, dayEnd));

   int fontSize   = 11;
   int lineHeight = 17;
   int xDist      = 10;
   int yBase      = 10;         // ระยะจากขอบล่างจอถึงบรรทัดล่างสุด
   int boxWidth   = 180;
   int boxHeight  = yBase - 4 + lineCount * lineHeight + 8;
   color dashColor = (totalToday >= 0) ? clrLime : C'255,90,90';

   // กล่องพื้นหลังทึบ (มุมซ้ายล่าง)
   if(ObjectFind(0, DASH_BG_NAME) < 0)
     {
      ObjectCreate(0, DASH_BG_NAME, OBJ_RECTANGLE_LABEL, 0, 0, 0);
      ObjectSetInteger(0, DASH_BG_NAME, OBJPROP_CORNER, CORNER_LEFT_LOWER);
      ObjectSetInteger(0, DASH_BG_NAME, OBJPROP_SELECTABLE, false);
      ObjectSetInteger(0, DASH_BG_NAME, OBJPROP_HIDDEN, true);
      ObjectSetInteger(0, DASH_BG_NAME, OBJPROP_BACK, false);
      ObjectSetInteger(0, DASH_BG_NAME, OBJPROP_BORDER_TYPE, BORDER_FLAT);
      ObjectSetInteger(0, DASH_BG_NAME, OBJPROP_COLOR, clrSilver);
      ObjectSetInteger(0, DASH_BG_NAME, OBJPROP_BGCOLOR, C'20,20,20');
      ObjectSetInteger(0, DASH_BG_NAME, OBJPROP_WIDTH, 1);
     }
   ObjectSetInteger(0, DASH_BG_NAME, OBJPROP_XDISTANCE, xDist - 6);
   ObjectSetInteger(0, DASH_BG_NAME, OBJPROP_YDISTANCE, yBase - 4);
   ObjectSetInteger(0, DASH_BG_NAME, OBJPROP_XSIZE, boxWidth);
   ObjectSetInteger(0, DASH_BG_NAME, OBJPROP_YSIZE, boxHeight);

   // สร้าง/อัปเดต Label ทีละบรรทัด เรียงจากล่างขึ้นบน (บรรทัดแรกอยู่บนสุด)
   for(int i = 0; i < lineCount; i++)
     {
      string objName = DASH_OBJ_NAME + "_L" + IntegerToString(i);
      int yOffset = yBase + (lineCount - 1 - i) * lineHeight;

      if(ObjectFind(0, objName) < 0)
        {
         ObjectCreate(0, objName, OBJ_LABEL, 0, 0, 0);
         ObjectSetInteger(0, objName, OBJPROP_CORNER, CORNER_LEFT_LOWER);
         ObjectSetInteger(0, objName, OBJPROP_ANCHOR, ANCHOR_LEFT_LOWER);
         ObjectSetString(0, objName, OBJPROP_FONT, "Consolas Bold");
         ObjectSetInteger(0, objName, OBJPROP_SELECTABLE, false);
         ObjectSetInteger(0, objName, OBJPROP_HIDDEN, true);
         ObjectSetInteger(0, objName, OBJPROP_BACK, false);
        }
      ObjectSetInteger(0, objName, OBJPROP_XDISTANCE, xDist);
      ObjectSetInteger(0, objName, OBJPROP_YDISTANCE, yOffset);
      ObjectSetInteger(0, objName, OBJPROP_FONTSIZE, fontSize);
      ObjectSetInteger(0, objName, OBJPROP_COLOR, (i <= 1) ? clrWhite : dashColor);
      ObjectSetString(0, objName, OBJPROP_TEXT, lines[i]);
     }

   ChartRedraw(0);
  }
