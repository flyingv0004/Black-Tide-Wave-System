int OnInit()
  {
   trade.SetExpertMagicNumber(InpMagic);
   trade.SetDeviationInPoints(InpSlippage);

   // สำคัญ: เรียก iCustom เพื่อ "บังคับ" ให้ indicator ถูกโหลดและคำนวณ
   // แม้จะไม่ได้อ่านค่าจาก buffer ของมันเลยก็ตาม เพราะ indicator วาด
   // signal object (ลูกศร BUY/SELL) ของมันเองในฟังก์ชัน OnCalculate()
   // ถ้าไม่เรียกบรรทัดนี้ EA จะต้องพึ่งการลาก indicator วางบนกราฟด้วยมือ
   // เท่านั้น (ใช้ได้บนกราฟจริง แต่ Strategy Tester โหมดปกติจะไม่รัน
   // indicator ที่ไม่ได้ถูกเรียกจากโค้ด EA ให้ ทำให้ backtest ไม่มีสัญญาณ)
   g_indiHandle = iCustom(_Symbol, _Period, InpIndicatorName);
   if(g_indiHandle == INVALID_HANDLE)
     {
      Print("ไม่สามารถโหลด indicator ได้: ", InpIndicatorName,
            " (เช็คว่าชื่อตรงกับใน Navigator และ compile ไว้ในโฟลเดอร์ Indicators แล้ว)");
      return(INIT_FAILED);
     }

   // parse ค่า multiplier ของระบบมาร์ติงเกลจาก input string (ระยะห่างราคาใช้ InpMartingaleGapUSD ค่าเดียวตรง ๆ)
   ParseDoubleList(InpMartingaleMultipliers, g_mtgMultipliers);
   ArrayResize(g_baskets, 0);

   // สำคัญ: รอให้ indicator คำนวณ "ครบ" ก่อนสแกนหา baseline
   // เพราะ iCustom() แค่สร้าง handle แต่การคำนวณจริงเกิดแบบ async เบื้องหลัง
   // ถ้าสแกนหา baseline ก่อนคำนวณเสร็จ อาจได้ค่าว่าง แล้วพอลูกศรเก่าโผล่มา
   // ทีหลัง (ตอน indicator คำนวณย้อนหลังเสร็จ) EA จะเข้าใจผิดว่าเป็นสัญญาณใหม่
   int totalBarsExpected = iBars(_Symbol, _Period);
   uint waitStart = GetTickCount();
   while(BarsCalculated(g_indiHandle) < totalBarsExpected && (GetTickCount() - waitStart) < 15000)
     {
      double warm[1];
      CopyBuffer(g_indiHandle, 0, 0, 1, warm);
      Sleep(200);
     }
   Print("BTW_Signal_EA: indicator calculated ", BarsCalculated(g_indiHandle), "/", totalBarsExpected, " bars ก่อนเริ่มทำงาน");

   // ตั้ง baseline: จำเวลาแท่งปัจจุบัน (ที่ยังไม่ปิด) ไว้เป็นจุดเริ่มต้น
   // เพื่อไม่ให้ EA ยิงออเดอร์ตามสัญญาณที่อยู่บนแท่งที่ปิดไปแล้วก่อนหน้านี้
   // (จะเริ่มเช็คสัญญาณก็ต่อเมื่อแท่งถัดจากนี้ปิดจริง ๆ เท่านั้น)
   g_lastCheckedBarTime = iTime(_Symbol, _Period, 0);

   // สร้าง handle EMA200 บน Timeframe ที่เลือกไว้สำหรับตัวกรอง MTF (สร้างไว้เสมอ
   // แม้จะยังไม่เปิดใช้ InpUseMTFFilter เพื่อให้พร้อมทันทีถ้าสลับเปิดทีหลัง)
   g_mtfEmaHandle = iMA(_Symbol, MapMTFTimeframe(InpMTFTimeframe), 200, 0, MODE_EMA, PRICE_CLOSE);
   if(g_mtfEmaHandle == INVALID_HANDLE)
     {
      Print("BTW_Signal_EA: ไม่สามารถสร้าง EMA200 handle สำหรับ MTF filter ได้ (err=", GetLastError(), ")");
      // ไม่ต้อง INIT_FAILED เพราะ EA ยังใช้งานได้ปกติถ้าปิด InpUseMTFFilter ไว้
     }

   // สร้าง handle EMA200 บน Timeframe ปัจจุบัน (_Period) สำหรับตัวกรองตัวที่สอง
   // เป็นคนละ handle กับ MTF ด้านบน เปิดพร้อมกันได้ทั้งคู่ (ดับเบิ้ลเช็ค)
   g_currentTfEmaHandle = iMA(_Symbol, _Period, 200, 0, MODE_EMA, PRICE_CLOSE);
   if(g_currentTfEmaHandle == INVALID_HANDLE)
     {
      Print("BTW_Signal_EA: ไม่สามารถสร้าง EMA200 handle สำหรับ Current-TF filter ได้ (err=", GetLastError(), ")");
     }

   Print("BTW_Signal_EA initialized. BUILD=", EA_BUILD_TAG,
         " Magic=", InpMagic,
         " Baseline bar=", TimeToString(g_lastCheckedBarTime, TIME_DATE|TIME_MINUTES),
         " Martingale=", (InpMartingaleEnabled ? "ON" : "OFF"),
         " MaxLevels=", InpMartingaleMaxLevels,
         " MultiplierListLen=", ArraySize(g_mtgMultipliers),
         " MTFFilter=", (InpUseMTFFilter ? "ON" : "OFF"),
         " CurrentTFFilter=", (InpUseCurrentTFFilter ? "ON" : "OFF"));

   // ตั้งค่าเริ่มต้นของ Daily Dashboard: log ขอบเขต "วันนี้" ที่ EA คำนวณได้ตอนเริ่มทำงาน
   // (ช่วยยืนยันว่า EA คำนวณวันถูกต้องไหม โดยเฉพาะตอนปิด-เปิด EA ใหม่กลางวัน)
   // หมายเหตุ: P/L และ Signals ไม่ได้เก็บสะสมในหน่วยความจำเลย ทุกครั้งที่ dashboard
   // รีเฟรช (ทุก ~2 วิ) จะ query จาก History ของ broker สดใหม่ตามขอบเขตวันที่คำนวณ
   // ณ ขณะนั้นเสมอ จึงรีเป็น 0 เองอัตโนมัติตอนข้ามวัน และแสดงค่าถูกต้องได้ทันที
   // แม้จะเพิ่งปิด-เปิด EA ใหม่ ไม่ต้องมีการ "รีเซ็ต" ใด ๆ เพราะไม่มีอะไรให้รีเซ็ต
   datetime dashDayStart, dashDayEnd;
   // v1.11 (candidate): ใช้ GetStableDayBoundaries() เพื่อให้ค่าที่ cache ไว้ตั้งแต่
   // OnInit ตรงกับค่าที่ CheckDailyCounterRollover/UpdateDailyDashboard จะใช้ต่อไปทุกจุด
   GetStableDayBoundaries(dashDayStart, dashDayEnd);
   Print("BTW_Signal_EA: ขอบเขตวันนี้ (สำหรับ Dashboard) = ",
         TimeToString(dashDayStart, TIME_DATE|TIME_MINUTES), " ถึง ",
         TimeToString(dashDayEnd, TIME_DATE|TIME_MINUTES), " (server time)");

   return(INIT_SUCCEEDED);
  }

