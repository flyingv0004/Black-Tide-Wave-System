void OnDeinit(const int reason)
  {
   if(g_indiHandle != INVALID_HANDLE)
      IndicatorRelease(g_indiHandle);
   if(g_mtfEmaHandle != INVALID_HANDLE)
      IndicatorRelease(g_mtfEmaHandle);
   if(g_currentTfEmaHandle != INVALID_HANDLE)
      IndicatorRelease(g_currentTfEmaHandle);

   ObjectDelete(0, DASH_BG_NAME);
   for(int i = 0; i < 6; i++)
      ObjectDelete(0, DASH_OBJ_NAME + "_L" + IntegerToString(i));
  }

//+------------------------------------------------------------------+
void OnTick()
  {
   // สำคัญ: indicator ที่โหลดผ่าน iCustom จะ "คำนวณใหม่" ก็ต่อเมื่อมีการ
   // ขอข้อมูลจากมันเท่านั้น (pull-based) การเรียก CopyBuffer แม้จะทิ้งค่า
   // ที่ได้ ก็เป็นการบังคับให้ indicator รัน OnCalculate() ของมันเอง
   double dummy[1];
   CopyBuffer(g_indiHandle, 0, 0, 1, dummy);

   // อัปเดตสถานะ basket ที่ยังเปิดอยู่เสมอ (ใช้จำกัดจำนวนชุดพร้อมกัน)
   // ต้องรันก่อน ManageMartingale และไม่ว่าจะเปิดมาร์ติงเกลหรือไม่ก็ตาม
   UpdateBasketLifecycle();

   // จัดการระบบมาร์ติงเกลทุก tick (ไม่ว่าจะมีสัญญาณใหม่หรือไม่)
   ManageMartingale();

   // จัดการระบบจับคู่ปิด (Pair-Close) แยกอิสระจากมาร์ติงเกลด้านบนโดยสิ้นเชิง
   ManagePairClose();

   // อัปเดต Daily Dashboard (เช็ค rollover วันใหม่ + วาดสรุปผลบนกราฟ)
   CheckDailyCounterRollover();
   UpdateDailyDashboard();

   // ตรวจจับ "เข้าแท่งใหม่": เช็คสัญญาณก็ต่อเมื่อเปลี่ยนแท่งเท่านั้น (ไม่เช็คซ้ำทุก tick)
   datetime currentBarOpenTime = iTime(_Symbol, _Period, 0);
   if(currentBarOpenTime == g_lastCheckedBarTime)
      return; // ยังอยู่แท่งเดิม ยังไม่มีแท่งใหม่ปิด ไม่ต้องเช็คสัญญาณ

   g_lastCheckedBarTime = currentBarOpenTime;

   // แท่งก่อนหน้า (shift=1) เพิ่งปิดสมบูรณ์แล้ว ณ จุดนี้ อ่านค่า buffer ที่ shift=1
   // (ไม่เคยอ่านที่ shift=0 เลย เพราะแท่งกำลังวิ่งอาจยังไม่นิ่ง/repaint ได้)
   double sigTypeBuf[1], entryBuf[1], slBuf[1], tp1Buf[1], tp2Buf[1];
   if(CopyBuffer(g_indiHandle, SIGBUF_TYPE,  1, 1, sigTypeBuf) <= 0) return;
   if(CopyBuffer(g_indiHandle, SIGBUF_ENTRY, 1, 1, entryBuf)   <= 0) return;
   if(CopyBuffer(g_indiHandle, SIGBUF_SL,    1, 1, slBuf)      <= 0) return;
   if(CopyBuffer(g_indiHandle, SIGBUF_TP1,   1, 1, tp1Buf)     <= 0) return;
   if(CopyBuffer(g_indiHandle, SIGBUF_TP2,   1, 1, tp2Buf)     <= 0) return;

   int sigType = (int)MathRound(sigTypeBuf[0]);
   if(sigType == 0)
      return; // แท่งที่เพิ่งปิดไม่มีสัญญาณ

   bool isBuy  = (sigType == 1 || sigType == 3);
   bool isSell = (sigType == 2 || sigType == 4);
   if(!isBuy && !isSell)
     {
      Print("BTW_Signal_EA: buffer type ไม่ตรง Buy/Sell (", sigType, ") ข้ามแท่งนี้");
      return;
     }

   datetime signalBarTime = iTime(_Symbol, _Period, 1);
   ProcessSignal(isBuy, entryBuf[0], slBuf[0], tp1Buf[0], tp2Buf[0], signalBarTime);
  }

