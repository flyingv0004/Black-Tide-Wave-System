//+------------------------------------------------------------------+
//| ปิดไม้ทั้งหมดของ basket ที่ระบุ (ใช้ตอนถึงเป้ากำไรด่วน)             |
//+------------------------------------------------------------------+
void CloseBasketPositions(const string basketId)
  {
   int total = PositionsTotal();
   for(int i = total - 1; i >= 0; i--)
     {
      ulong ticket = PositionGetTicket(i);
      if(ticket == 0) continue;
      if(!PositionSelectByTicket(ticket)) continue;
      if(PositionGetInteger(POSITION_MAGIC) != InpMagic) continue;
      if(PositionGetString(POSITION_SYMBOL) != _Symbol) continue; // v1.20 symbol-safety
      string cmt = PositionGetString(POSITION_COMMENT);
      if(StringFind(cmt, basketId) != 0) continue;
      trade.PositionClose(ticket);
     }
  }

//+------------------------------------------------------------------+
//| คำนวณขอบเขตเวลา "วันนี้" (ในหน่วยเวลา server เพื่อใช้ query        |
//| HistorySelect) โดยเทียบจากเวลาไทยหรือเวลา server ตาม Input        |
//| เวลาไทยคำนวณโดยเทียบเวลาเครื่อง (TimeLocal) กับเวลา server        |
//| (TimeCurrent) สดใหม่ทุกครั้ง ไม่ต้องเดา GMT offset ของโบรกเกอร์เอง  |
//| (ใช้ได้ก็ต่อเมื่อนาฬิกาเครื่องตั้งเป็นเวลาไทยถูกต้องอยู่แล้ว)        |
//|                                                                   |
//| v1.21 FIX: InpUseThaiTime พังเมื่อรันใน Strategy Tester เพราะ      |
//| TimeLocal() คือเวลาจริงของเครื่อง (ไม่ได้จำลองตามเวลา backtest     |
//| เลย) ขณะที่ TimeCurrent() คือเวลาจำลองที่วิ่งเร็วมาก ย่อสูตรได้เป็น |
//| dayStartServer = TimeCurrent() - (TimeLocal()%86400) ซึ่งเมื่อ     |
//| (TimeLocal()%86400) แทบคงที่ตลอดการรัน backtest แต่ TimeCurrent()  |
//| วิ่งไปเรื่อย ๆ ผลคือ dayStartServer ขยับตาม TimeCurrent() แทบทุก    |
//| แท่ง ทำให้ระบบเข้าใจผิดว่า "ข้ามวันใหม่" แทบทุกครั้งที่เช็ค (ไม่ใช่  |
//| วันละครั้งจริง) แก้โดยเช็คว่ากำลังรันอยู่ใน Tester หรือไม่ ถ้าใช่    |
//| จะสลับไปใช้ Server Time แทนโดยอัตโนมัติ (แจ้งเตือนครั้งเดียว        |
//| ไม่สแปม) ตอนรันจริง/demo ยังใช้ Thai Time ได้ปกติไม่กระทบ           |
//+------------------------------------------------------------------+
void GetDayBoundaries(datetime &dayStartServer, datetime &dayEndServer)
  {
   bool useThaiTimeNow = InpUseThaiTime;

   if(useThaiTimeNow && MQLInfoInteger(MQL_TESTER))
     {
      useThaiTimeNow = false;
      if(!g_thaiTimeTesterWarningPrinted)
        {
         Print("BTW_Signal_EA: [WARNING] InpUseThaiTime=true ใช้งานไม่ได้ถูกต้องใน Strategy Tester ",
               "(TimeLocal() เป็นเวลาจริงของเครื่อง ไม่ได้จำลองตามเวลา backtest) ",
               "EA จะสลับไปใช้ Server Time แทนโดยอัตโนมัติสำหรับการรัน/optimize นี้เท่านั้น ",
               "P/L และ Signals ของ Dashboard ยังถูกต้องเป๊ะ แค่ขอบเขต 'วัน' อ้างอิงเวลา server ชั่วคราว ",
               "(ตอนรันบนเครื่องจริง/demo จะใช้ Thai Time ตามที่ตั้งไว้ได้ปกติ ไม่กระทบ)");
         g_thaiTimeTesterWarningPrinted = true;
        }
     }

   if(useThaiTimeNow)
     {
      long offsetSeconds = (long)TimeLocal() - (long)TimeCurrent(); // ส่วนต่างเวลาเครื่อง - เวลา server ขณะนี้
      datetime dayStartLocal = TimeLocal() - (TimeLocal() % 86400);
      dayStartServer = dayStartLocal - (datetime)offsetSeconds;
     }
   else
     {
      dayStartServer = TimeCurrent() - (TimeCurrent() % 86400);
     }
   dayEndServer = dayStartServer + 86400;
  }

//+------------------------------------------------------------------+
//| v1.22: เวอร์ชัน "นิ่ง" ของ GetDayBoundaries — คำนวณค่าดิบจากสูตร    |
//| เดิม แล้วเทียบกับค่าที่ cache ไว้ด้วย tolerance (ไม่ใช่ exact        |
//| equality) ถ้าต่างกันไม่เกิน DAY_CHANGE_TOLERANCE_SEC ถือว่าเป็น     |
//| "จิตเตอร์" ของการอ่านนาฬิกาสด ไม่ใช่วันเปลี่ยนจริง จะไม่แตะ cache    |
//| เลย ทุกฟังก์ชันที่ต้องใช้ขอบเขตวัน (rollover log, HistorySelect     |
//| ของ dashboard) ต้องเรียกฟังก์ชันนี้แทน GetDayBoundaries() ตรง ๆ     |
//| เพื่อให้ได้ค่าที่นิ่งเหมือนกันทุกจุดใน tick เดียวกัน                |
//+------------------------------------------------------------------+
void GetStableDayBoundaries(datetime &dayStartOut, datetime &dayEndOut)
  {
   datetime rawStart, rawEnd;
   GetDayBoundaries(rawStart, rawEnd);

   const long DAY_CHANGE_TOLERANCE_SEC = 3600; // 1 ชั่วโมง: กันจิตเตอร์ (~1-2 วิ) ได้สบาย
                                                // แต่เล็กกว่าการข้ามวันจริง (86400 วิ) มาก ๆ

   bool isFirstRun      = (g_cachedDayStart == 0);
   bool isRealDayChange = isFirstRun || (MathAbs((long)rawStart - (long)g_cachedDayStart) > DAY_CHANGE_TOLERANCE_SEC);

   if(isRealDayChange)
     {
      if(!isFirstRun)
        {
         Print("BTW_Signal_EA: ข้ามวันใหม่แล้ว ขอบเขตวันนี้ = ",
               TimeToString(rawStart, TIME_DATE|TIME_MINUTES), " ถึง ",
               TimeToString(rawEnd, TIME_DATE|TIME_MINUTES), " (server time) — Dashboard จะเริ่มนับจาก 0 ใหม่โดยอัตโนมัติ");

         // v1.20/1.22: บังคับให้พิมพ์สรุป debug อีกครั้งตอนข้ามวันจริง แม้ยอด/จำนวน
         // ของวันใหม่จะบังเอิญตรงกับของวันเก่าก็ตาม ไม่ต้องรีเซ็ต g_debugLastPrintedTicket
         // เพราะ deal ticket ของ MT5 เพิ่มขึ้นเรื่อย ๆ ข้ามวันอยู่แล้ว ไม่มีทางย้อนกลับ
         g_debugLastMatchedCount = -1;
         g_debugLastRealizedSum  = 0.0;
        }
      g_cachedDayStart = rawStart;
      g_cachedDayEnd   = rawEnd;
     }

   dayStartOut = g_cachedDayStart;
   dayEndOut   = g_cachedDayEnd;
  }

//+------------------------------------------------------------------+
//| เช็คว่าเข้าวันใหม่หรือยัง (ตามเขตเวลาที่เลือก) ถ้าใช่ให้รีเซ็ตตัวนับ|
//| v1.22: ย้าย logic การเปรียบเทียบ/cache ไปอยู่ที่ GetStableDayBoundaries|
//| ทั้งหมดแล้ว ฟังก์ชันนี้เหลือแค่เรียกมันเพื่อ trigger การเช็คทุก tick |
//+------------------------------------------------------------------+
void CheckDailyCounterRollover()
  {
   datetime dayStart, dayEnd;
   GetStableDayBoundaries(dayStart, dayEnd);
  }

//+------------------------------------------------------------------+
//| รวมกำไรที่ "ปิดไปแล้วจริง" (realized) ของ EA นี้ ภายในช่วงเวลาที่ระบุ|
//| v1.20: InpDebugDashboard พิมพ์เฉพาะ "การเปลี่ยนแปลง" เท่านั้น       |
//| (deal ใหม่ที่ยังไม่เคยพิมพ์ + สรุปรวมเฉพาะตอนยอด/จำนวนเปลี่ยนจริง)  |
//| แทนการพิมพ์ทุก deal ของทั้งวันซ้ำทุกครั้งที่ dashboard รีเฟรช       |
//| (~2 วิ) ซึ่งทำให้ log บวมเป็นหมื่นบรรทัดในวันเดียวถ้าเทรดนาน/บ่อย   |
//+------------------------------------------------------------------+
double GetRealizedProfitInRange(datetime rangeStart, datetime rangeEnd)
  {
   double sum = 0;
   int matchedCount = 0;
   ulong maxTicketThisPass = g_debugLastPrintedTicket;

   if(!HistorySelect(rangeStart, rangeEnd))
     {
      if(InpDebugDashboard)
         Print("BTW_Signal_EA DEBUG: HistorySelect ล้มเหลว range=", TimeToString(rangeStart), " - ", TimeToString(rangeEnd));
      return 0;
     }

   int total = HistoryDealsTotal();
   for(int i = 0; i < total; i++)
     {
      ulong ticket = HistoryDealGetTicket(i);
      if(ticket == 0) continue;
      if(HistoryDealGetInteger(ticket, DEAL_MAGIC) != InpMagic) continue;
      if(HistoryDealGetString(ticket, DEAL_SYMBOL) != _Symbol) continue; // v1.20 symbol-safety
      double dealSum = HistoryDealGetDouble(ticket, DEAL_PROFIT)
                      + HistoryDealGetDouble(ticket, DEAL_SWAP)
                      + HistoryDealGetDouble(ticket, DEAL_COMMISSION);
      sum += dealSum;
      matchedCount++;

      // v1.20: พิมพ์รายละเอียดเฉพาะ deal ที่ ticket ใหม่กว่าที่เคยพิมพ์ไปแล้วเท่านั้น
      // (deal ticket ของ MT5 เพิ่มขึ้นเรื่อย ๆ ไม่มีวันย้อนกลับ ใช้เทียบ "ใหม่/เก่า" ได้)
      if(InpDebugDashboard && ticket > g_debugLastPrintedTicket)
        {
         Print("BTW_Signal_EA DEBUG: deal#", ticket,
               " time=", TimeToString(HistoryDealGetInteger(ticket, DEAL_TIME), TIME_DATE|TIME_SECONDS),
               " magic=", HistoryDealGetInteger(ticket, DEAL_MAGIC),
               " entry=", EnumToString((ENUM_DEAL_ENTRY)HistoryDealGetInteger(ticket, DEAL_ENTRY)),
               " profit+swap+comm=", DoubleToString(dealSum, 2),
               " comment=", HistoryDealGetString(ticket, DEAL_COMMENT));
        }
      if(ticket > maxTicketThisPass)
         maxTicketThisPass = ticket;
     }

   if(InpDebugDashboard)
     {
      g_debugLastPrintedTicket = maxTicketThisPass; // เลื่อนเครื่องหมาย "เคยพิมพ์แล้ว" ไปยัง ticket ล่าสุด

      // v1.20: พิมพ์สรุปรวมเฉพาะตอนยอด/จำนวน deal เปลี่ยนจากครั้งก่อนจริง ๆ เท่านั้น
      // (กันพิมพ์บรรทัดเดิมซ้ำทุก 2 วิระหว่างที่ยังไม่มีอะไรเปลี่ยนแปลง)
      bool changed = (matchedCount != g_debugLastMatchedCount) || (MathAbs(sum - g_debugLastRealizedSum) > 0.0001);
      if(changed)
        {
         Print("BTW_Signal_EA DEBUG: ช่วงเวลาที่ query = ", TimeToString(rangeStart, TIME_DATE|TIME_SECONDS),
               " ถึง ", TimeToString(rangeEnd, TIME_DATE|TIME_SECONDS),
               " (server time) | รวม deal ที่นับได้ = ", matchedCount,
               " | ผลรวม = ", DoubleToString(sum, 2), " USD | HistoryDealsTotal ทั้งหมด (ไม่กรอง) = ", total);
         g_debugLastMatchedCount = matchedCount;
         g_debugLastRealizedSum  = sum;
        }
     }

   return sum;
  }

//+------------------------------------------------------------------+
//| รวมกำไรลอย (unrealized) ของทุกไม้ที่ EA นี้เปิดอยู่ตอนนี้            |
//+------------------------------------------------------------------+
double GetFloatingProfitAll()
  {
   double sum = 0;
   int total = PositionsTotal();
   for(int i = 0; i < total; i++)
     {
      ulong ticket = PositionGetTicket(i);
      if(ticket == 0) continue;
      if(!PositionSelectByTicket(ticket)) continue;
      if(PositionGetInteger(POSITION_MAGIC) != InpMagic) continue;
      if(PositionGetString(POSITION_SYMBOL) != _Symbol) continue; // v1.20 symbol-safety
      sum += PositionGetDouble(POSITION_PROFIT) + PositionGetDouble(POSITION_SWAP);
     }
   return sum;
  }

//+------------------------------------------------------------------+
//| นับจำนวนสัญญาณที่เปิดไม้แรกวันนี้ โดยนับจาก "ประวัติจริง" ของ      |
//| broker (นับ basketId ที่ไม่ซ้ำกันจาก deal ฝั่งเปิดที่มี Magic       |
//| ตรงกัน) แทนการใช้ตัวนับสะสมในหน่วยความจำ เพราะตัวนับในหน่วยความจำ  |
//| จะรีเซ็ตเป็น 0 ทุกครั้งที่ EA reload (ถอด-แนบใหม่/compile ใหม่)     |
//| ทำให้นับไม่ครบถ้า reload ระหว่างวัน วิธีนี้นับจากข้อมูลจริงเสมอ     |
//| แม่นยำไม่ว่าจะ reload กี่ครั้งก็ตาม                                |
//+------------------------------------------------------------------+
int GetDailySignalCountFromHistory(datetime rangeStart, datetime rangeEnd)
  {
   string seenBaskets[];
   int seenCount = 0;

   if(!HistorySelect(rangeStart, rangeEnd))
      return 0;

   int total = HistoryDealsTotal();
   for(int i = 0; i < total; i++)
     {
      ulong ticket = HistoryDealGetTicket(i);
      if(ticket == 0) continue;
      if(HistoryDealGetInteger(ticket, DEAL_MAGIC) != InpMagic) continue;
      if(HistoryDealGetString(ticket, DEAL_SYMBOL) != _Symbol) continue; // v1.20 symbol-safety
      if((ENUM_DEAL_ENTRY)HistoryDealGetInteger(ticket, DEAL_ENTRY) != DEAL_ENTRY_IN) continue; // เอาเฉพาะ deal ฝั่งเปิด

      string cmt = HistoryDealGetString(ticket, DEAL_COMMENT);
      int sep = StringFind(cmt, "|");
      string basketId = (sep >= 0) ? StringSubstr(cmt, 0, sep) : cmt;

      bool found = false;
      for(int k = 0; k < seenCount; k++)
        {
         if(seenBaskets[k] == basketId)
           {
            found = true;
            break;
           }
        }
      if(!found)
        {
         ArrayResize(seenBaskets, seenCount + 1);
         seenBaskets[seenCount] = basketId;
         seenCount++;
        }
     }
   return seenCount;
  }

//+------------------------------------------------------------------+
//| วาด/อัปเดตกล่องสรุปผลประจำวันที่มุมซ้ายล่างของกราฟ                  |
//| หมายเหตุ: OBJ_LABEL ของ MT5 ไม่รองรับข้อความหลายบรรทัดในตัวเดียว   |
//| (ใส่ \n ไปแล้วมันไม่ตัดบรรทัดจริง กลายเป็นเส้นเดียวยาวทะลุขอบจอ)     |
//| จึงต้องสร้าง Label แยกทีละบรรทัดแทน แล้วเรียงตำแหน่ง Y เอง         |
//+------------------------------------------------------------------+
void UpdateDailyDashboard()
  {
   int lineCount = 6;

   if(!InpShowDailyDashboard)
     {
      ObjectDelete(0, DASH_BG_NAME);
      for(int i = 0; i < lineCount; i++)
         ObjectDelete(0, DASH_OBJ_NAME + "_L" + IntegerToString(i));
      return;
     }

   // จำกัดความถี่อัปเดต กันหนักเครื่อง (ทุกประมาณ 2 วินาทีพอ)
   if(GetTickCount() - g_lastDashboardUpdate < 2000)
      return;
   g_lastDashboardUpdate = GetTickCount();

   datetime dayStart, dayEnd;
   // v1.22: ใช้ค่าที่ cache ไว้แล้ว (นิ่ง ไม่สั่นตามจิตเตอร์ของนาฬิกาสด) แทนการเรียก
   // GetDayBoundaries() ตรง ๆ กันไม่ให้ deal ที่เวลาใกล้ขอบเขตวันถูกนับเข้า/ออกสลับไปมา
   GetStableDayBoundaries(dayStart, dayEnd);

   double realized = GetRealizedProfitInRange(dayStart, dayEnd);
   double floating = GetFloatingProfitAll();
   double totalToday = realized + floating;

   string tzLabel = InpUseThaiTime ? "Thai Time" : "Server Time";

   string lines[6];
   lines[0] = "BTW Signal EA - Today";
   lines[1] = "(" + tzLabel + ")";
   lines[2] = "P/L: " + DoubleToString(totalToday, 2) + " USD";
   lines[3] = "Closed: " + DoubleToString(realized, 2);
   lines[4] = "Floating: " + DoubleToString(floating, 2);
   lines[5] = "Signals: " + IntegerToString(GetDailySignalCountFromHistory(dayStart, dayEnd));

   int fontSize   = 11;
   int lineHeight = 17;
   int xDist      = 10;
   int yBase      = 10;         // ระยะจากขอบล่างจอถึงบรรทัดล่างสุด
   int boxWidth   = 180;
   int boxHeight  = yBase - 4 + lineCount * lineHeight + 8;
   color dashColor = (totalToday >= 0) ? clrLime : C'255,90,90';

   // กล่องพื้นหลังทึบ (มุมซ้ายล่าง)
   if(ObjectFind(0, DASH_BG_NAME) < 0)
     {
      ObjectCreate(0, DASH_BG_NAME, OBJ_RECTANGLE_LABEL, 0, 0, 0);
      ObjectSetInteger(0, DASH_BG_NAME, OBJPROP_CORNER, CORNER_LEFT_LOWER);
      ObjectSetInteger(0, DASH_BG_NAME, OBJPROP_SELECTABLE, false);
      ObjectSetInteger(0, DASH_BG_NAME, OBJPROP_HIDDEN, true);
      ObjectSetInteger(0, DASH_BG_NAME, OBJPROP_BACK, false);
      ObjectSetInteger(0, DASH_BG_NAME, OBJPROP_BORDER_TYPE, BORDER_FLAT);
      ObjectSetInteger(0, DASH_BG_NAME, OBJPROP_COLOR, clrSilver);
      ObjectSetInteger(0, DASH_BG_NAME, OBJPROP_BGCOLOR, C'20,20,20');
      ObjectSetInteger(0, DASH_BG_NAME, OBJPROP_WIDTH, 1);
     }
   ObjectSetInteger(0, DASH_BG_NAME, OBJPROP_XDISTANCE, xDist - 6);
   ObjectSetInteger(0, DASH_BG_NAME, OBJPROP_YDISTANCE, yBase - 4);
   ObjectSetInteger(0, DASH_BG_NAME, OBJPROP_XSIZE, boxWidth);
   ObjectSetInteger(0, DASH_BG_NAME, OBJPROP_YSIZE, boxHeight);

   // สร้าง/อัปเดต Label ทีละบรรทัด เรียงจากล่างขึ้นบน (บรรทัดแรกอยู่บนสุด)
   for(int i = 0; i < lineCount; i++)
     {
      string objName = DASH_OBJ_NAME + "_L" + IntegerToString(i);
      int yOffset = yBase + (lineCount - 1 - i) * lineHeight;

      if(ObjectFind(0, objName) < 0)
        {
         ObjectCreate(0, objName, OBJ_LABEL, 0, 0, 0);
         ObjectSetInteger(0, objName, OBJPROP_CORNER, CORNER_LEFT_LOWER);
         ObjectSetInteger(0, objName, OBJPROP_ANCHOR, ANCHOR_LEFT_LOWER);
         ObjectSetString(0, objName, OBJPROP_FONT, "Consolas Bold");
         ObjectSetInteger(0, objName, OBJPROP_SELECTABLE, false);
         ObjectSetInteger(0, objName, OBJPROP_HIDDEN, true);
         ObjectSetInteger(0, objName, OBJPROP_BACK, false);
        }
      ObjectSetInteger(0, objName, OBJPROP_XDISTANCE, xDist);
      ObjectSetInteger(0, objName, OBJPROP_YDISTANCE, yOffset);
      ObjectSetInteger(0, objName, OBJPROP_FONTSIZE, fontSize);
      ObjectSetInteger(0, objName, OBJPROP_COLOR, (i <= 1) ? clrWhite : dashColor);
      ObjectSetString(0, objName, OBJPROP_TEXT, lines[i]);
     }

   ChartRedraw(0);
  }
