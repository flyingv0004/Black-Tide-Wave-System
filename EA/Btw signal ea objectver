int      g_debugLastMatchedCount  = -1;   // จำนวน deal ล่าสุดที่เคย Print สรุปไปแล้ว (-1 = ยังไม่เคยพิมพ์)
bool     g_thaiTimeTesterWarningPrinted = false; // v1.21: กันแจ้งเตือน Thai-Time-in-Tester ซ้ำสแปม (พิมพ์ครั้งเดียวพอ)

