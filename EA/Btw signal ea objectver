//--- internal state: มาร์ติงเกล
struct MartingaleBasket
  {
   bool     active;
   bool     isBuy;
   string   basketId;         // = timestamp ของแท่งสัญญาณ ใช้จับกลุ่มออเดอร์ผ่าน comment
   double   slPrice;          // ราคาที่ไม้แก้ชั้น 1 จะเปิด (= SL เดิมของสัญญาณ)
   double   baseLot;          // Lot รวมของสัญญาณเดิม ใช้คูณกับ multiplier แต่ละชั้น
   int      gridLevel;        // จำนวนไม้แก้ที่เปิดไปแล้วในชุดนี้ (0 = ยังไม่แก้เลย)
   double   nextTriggerPrice; // ราคาที่ไม้แก้ชั้นถัดไปจะเปิด (v1.20: อิงราคาเปิดจริงของไม้ล่าสุด ไม่ใช่กริดคงที่ตายตัวอีกต่อไป)

   // --- v1.20: กำไรที่ Pair-Close ล็อกไว้แล้ว (realized) สะสมของ basket นี้ ---
   // ใช้รวมกับ floating profit ปัจจุบันตอนเช็คเงื่อนไขปิดทั้งชุดฉุกเฉิน
   // (InpMartingaleCloseProfitUSD) กันไม่ให้กำไรที่ปิดไปแล้วหายจากสมการ
   double   realizedProfit;

   // --- v1.20: Pending Replacement Queue ---
   // เมื่อ Pair-Close ปิดคู่สำเร็จแต่เปิดไม้ทดแทนล้มเหลว จะเก็บสถานะไว้ที่นี่
   // แล้วพยายามเปิดซ้ำอัตโนมัติทุก tick ไม่จำกัดจำนวนครั้ง จนกว่าจะสำเร็จ
   bool     pendingReplacement;      // true = มีไม้ทดแทนค้างรอเปิดอยู่
   bool     pendingIsBuy;            // ทิศทางของไม้ที่รอเปิด (เผื่ออนาคตต้องอ้างอิงแยกจาก b.isBuy)
   double   pendingLot;              // ขนาด lot ของไม้ที่รอเปิด
   uint     pendingFirstAttemptTick; // GetTickCount() ตอนเริ่มรอครั้งแรก (ใช้อ้างอิง/log)
   uint     pendingLastAlertTick;    // GetTickCount() ตอนแจ้งเตือนครั้งล่าสุด (คุมความถี่ Alert)
  };

MartingaleBasket g_baskets[];
double g_mtgMultipliers[];

//--- internal state: Daily Dashboard
#define DASH_OBJ_NAME "BTW_EA_Dashboard"
#define DASH_BG_NAME  "BTW_EA_Dashboard_BG"

// v1.22: เดิมเก็บแค่ dayStart ล่าสุดไว้เทียบแบบ exact equality (datetime != datetime)
// ปัญหาคือ GetDayBoundaries() (โหมด Thai Time) คำนวณจาก TimeLocal() กับ TimeCurrent()
// ซึ่งเป็นการอ่านนาฬิกาสด "สองครั้งคนละจังหวะ" (ห่างกันแค่เสี้ยววินาที) ทำให้ค่าที่ได้
// อาจสั่น ±1-2 วินาทีระหว่างรอบถัดไปแม้เป็นวันเดียวกันจริง ถ้าเทียบแบบ exact equality
// จะเข้าใจผิดว่า "วันเปลี่ยน" ทุกครั้งที่สั่น และถ้าบังเอิญมี deal ที่เวลาใกล้ขอบเขตวัน
// พอดี (เช่นใกล้เที่ยงคืนไทย) จะถูกนับเข้า/ออกจากช่วงสลับไปมาทุกครั้งที่สั่นด้วย ทำให้
// ยอด Dashboard "วิ่ง" ไปมาระหว่าง 2 ค่า แก้โดยเปลี่ยนมา "cache" ขอบเขตวันที่นิ่งแล้วไว้ใช้
// ตลอดทั้งวัน แล้วรีเฟรช cache ก็ต่อเมื่อค่าที่คำนวณสดต่างจาก cache เกิน tolerance
// (ใหญ่กว่าจิตเตอร์มาก แต่เล็กกว่าการข้ามวันจริง 86400 วิมาก ๆ) เท่านั้น — ดู
// GetStableDayBoundaries() ด้านล่าง ซึ่งเป็นจุดเดียวที่อ่าน/เขียนตัวแปรนี้
datetime g_cachedDayStart      = 0;
datetime g_cachedDayEnd        = 0;
uint     g_lastDashboardUpdate = 0;

// --- v1.20: ตัวตามรอยสำหรับลด spam ของ InpDebugDashboard ---
