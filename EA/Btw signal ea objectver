int OnInit()
  {
   trade.SetExpertMagicNumber(InpMagic);
   trade.SetDeviationInPoints(InpSlippage);

   // สำคัญ: เรียก iCustom เพื่อ "บังคับ" ให้ indicator ถูกโหลดและคำนวณ
   // แม้จะไม่ได้อ่านค่าจาก buffer ของมันเลยก็ตาม เพราะ indicator วาด
   // signal object (ลูกศร BUY/SELL) ของมันเองในฟังก์ชัน OnCalculate()
   // ถ้าไม่เรียกบรรทัดนี้ EA จะต้องพึ่งการลาก indicator วางบนกราฟด้วยมือ
   // เท่านั้น (ใช้ได้บนกราฟจริง แต่ Strategy Tester โหมดปกติจะไม่รัน
   // indicator ที่ไม่ได้ถูกเรียกจากโค้ด EA ให้ ทำให้ backtest ไม่มีสัญญาณ)
   g_indiHandle = iCustom(_Symbol, _Period, InpIndicatorName);
   if(g_indiHandle == INVALID_HANDLE)
     {
      Print("ไม่สามารถโหลด indicator ได้: ", InpIndicatorName,
            " (เช็คว่าชื่อตรงกับใน Navigator และ compile ไว้ในโฟลเดอร์ Indicators แล้ว)");
      return(INIT_FAILED);
     }

   // parse ค่า multiplier ของระบบมาร์ติงเกลจาก input string (ระยะห่างราคาใช้ InpMartingaleGapUSD ค่าเดียวตรง ๆ)
   ParseDoubleList(InpMartingaleMultipliers, g_mtgMultipliers);
   ArrayResize(g_baskets, 0);

   // v1.24: กู้คืน basket ที่เปิดค้างอยู่จริงในตลาด (ถ้ามี) กลับเข้า g_baskets[]
   // จำเป็นเพราะ g_baskets[] อยู่ในหน่วยความจำล้วน ๆ ถูกล้างเป็นค่าว่างทุกครั้งที่ EA
   // เริ่มทำงานใหม่ (reload/compile ใหม่/restart terminal) แต่ไม้จริงในตลาดไม่ได้หายไป
   // ด้วย ถ้าไม่กู้คืน basket เหล่านั้นจะกลายเป็น "ไม้กำพร้า" ไม่มีการเช็คปิดกำไรด่วน/
   // pair-close ดูแลอีกเลย และ InpMaxConcurrentBaskets จะนับพลาด (เพราะ
   // CountActiveBaskets() วนดูจาก g_baskets[] เท่านั้น ถ้าว่างเปล่าจะนับเป็น 0 ทั้งที่
   // จริงมีไม้ค้างอยู่แล้ว) ต้องทำหลัง ArrayResize(g_baskets,0) ด้านบนเสมอ
   RecoverBasketsFromOpenPositions();

   // v1.25: override gridLevel ด้วยค่าที่กู้จากไฟล์ (แม่นยำกว่าที่แกะจาก comment ใน
   // RecoverBasketsFromOpenPositions() ด้านบน เพราะ comment ของ order/position ถูก
   // MT5/broker ตัดที่ ~31 ตัวอักษรจริง — ยืนยันแล้วว่าตัดที่ข้อมูล ไม่ใช่แค่แสดงผล)
   // ต้องเรียกหลัง RecoverBasketsFromOpenPositions() เสมอ เพราะต้องมี basket อยู่ใน
   // g_baskets[] ให้ override ก่อนแล้วถึงจะมีผล
   LoadGridLevelsFromFile();

   // สำคัญ: รอให้ indicator คำนวณ "ครบ" ก่อนสแกนหา baseline
   // เพราะ iCustom() แค่สร้าง handle แต่การคำนวณจริงเกิดแบบ async เบื้องหลัง
   // ถ้าสแกนหา baseline ก่อนคำนวณเสร็จ อาจได้ค่าว่าง แล้วพอลูกศรเก่าโผล่มา
   // ทีหลัง (ตอน indicator คำนวณย้อนหลังเสร็จ) EA จะเข้าใจผิดว่าเป็นสัญญาณใหม่
   int totalBarsExpected = iBars(_Symbol, _Period);
   uint waitStart = GetTickCount();
   while(BarsCalculated(g_indiHandle) < totalBarsExpected && (GetTickCount() - waitStart) < 15000)
     {
      double warm[1];
      CopyBuffer(g_indiHandle, 0, 0, 1, warm);
      Sleep(200);
     }
   Print("BTW_Signal_EA: indicator calculated ", BarsCalculated(g_indiHandle), "/", totalBarsExpected, " bars ก่อนเริ่ม baseline scan");

   // สร้าง handle EMA200 บน Timeframe ที่เลือกไว้สำหรับตัวกรอง MTF (สร้างไว้เสมอ
   // แม้จะยังไม่เปิดใช้ InpUseMTFFilter เพื่อให้พร้อมทันทีถ้าสลับเปิดทีหลัง)
   g_mtfEmaHandle = iMA(_Symbol, MapMTFTimeframe(InpMTFTimeframe), 200, 0, MODE_EMA, PRICE_CLOSE);
   if(g_mtfEmaHandle == INVALID_HANDLE)
     {
      Print("BTW_Signal_EA: ไม่สามารถสร้าง EMA200 handle สำหรับ MTF filter ได้ (err=", GetLastError(), ")");
      // ไม่ต้อง INIT_FAILED เพราะ EA ยังใช้งานได้ปกติถ้าปิด InpUseMTFFilter ไว้
     }

   // สร้าง handle EMA200 บน Timeframe ปัจจุบัน (_Period) สำหรับตัวกรองตัวที่สอง
   // เป็นคนละ handle กับ MTF ด้านบน เปิดพร้อมกันได้ทั้งคู่ (ดับเบิ้ลเช็ค)
   g_currentTfEmaHandle = iMA(_Symbol, _Period, 200, 0, MODE_EMA, PRICE_CLOSE);
   if(g_currentTfEmaHandle == INVALID_HANDLE)
     {
      Print("BTW_Signal_EA: ไม่สามารถสร้าง EMA200 handle สำหรับ Current-TF filter ได้ (err=", GetLastError(), ")");
     }

   // ตั้ง baseline: จำสัญญาณล่าสุดที่มีอยู่แล้วตอนเปิด EA ไว้ก่อน
   // เพื่อไม่ให้ EA ยิงออเดอร์ย้อนหลังตามสัญญาณเก่าที่เคยเกิดขึ้นแล้ว
   string latest;
   if(GetLatestSignalObject(latest))
      g_lastProcessedSignal = latest;

   Print("BTW_Signal_EA initialized. BUILD=", EA_BUILD_TAG,
         " Magic=", InpMagic,
         " Symbol=", _Symbol,
         " Baseline signal=", g_lastProcessedSignal,
         " Martingale=", (InpMartingaleEnabled ? "ON" : "OFF"),
         " MaxLevels=", InpMartingaleMaxLevels,
         " MultiplierListLen=", ArraySize(g_mtgMultipliers),
         " MTFFilter=", (InpUseMTFFilter ? "ON" : "OFF"),
         " CurrentTFFilter=", (InpUseCurrentTFFilter ? "ON" : "OFF"),
         " PairClose=", (InpPairCloseEnabled ? "ON" : "OFF"),
         " PairCloseStartLevel=", InpPairCloseStartLevel,
         " PendingAlertIntervalSec=", InpPendingAlertIntervalSec,
         " RecoveredBaskets=", ArraySize(g_baskets)); // v1.24: จำนวน basket ที่กู้คืนได้ (0 = ไม่มีไม้ค้างตอนเริ่ม)

   // ตั้งค่าเริ่มต้นของ Daily Dashboard: log ขอบเขต "วันนี้" ที่ EA คำนวณได้ตอนเริ่มทำงาน
   // (ช่วยยืนยันว่า EA คำนวณวันถูกต้องไหม โดยเฉพาะตอนปิด-เปิด EA ใหม่กลางวัน)
   // หมายเหตุ: P/L และ Signals ไม่ได้เก็บสะสมในหน่วยความจำเลย ทุกครั้งที่ dashboard
   // รีเฟรช (ทุก ~2 วิ) จะ query จาก History ของ broker สดใหม่ตามขอบเขตวันที่คำนวณ
   // ณ ขณะนั้นเสมอ จึงรีเป็น 0 เองอัตโนมัติตอนข้ามวัน และแสดงค่าถูกต้องได้ทันที
   // แม้จะเพิ่งปิด-เปิด EA ใหม่ ไม่ต้องมีการ "รีเซ็ต" ใด ๆ เพราะไม่มีอะไรให้รีเซ็ต
   datetime dashDayStart, dashDayEnd;
   // v1.22: ใช้ GetStableDayBoundaries() เพื่อให้ค่าที่ cache ไว้ตั้งแต่ OnInit ตรงกับ
   // ค่าที่ CheckDailyCounterRollover/UpdateDailyDashboard จะใช้ต่อไปทุกจุด
   GetStableDayBoundaries(dashDayStart, dashDayEnd);
   Print("BTW_Signal_EA: ขอบเขตวันนี้ (สำหรับ Dashboard) = ",
         TimeToString(dashDayStart, TIME_DATE|TIME_MINUTES), " ถึง ",
         TimeToString(dashDayEnd, TIME_DATE|TIME_MINUTES), " (server time)");

   return(INIT_SUCCEEDED);
  }

//+------------------------------------------------------------------+
void OnDeinit(const int reason)
  {
   if(g_indiHandle != INVALID_HANDLE)
      IndicatorRelease(g_indiHandle);
   if(g_mtfEmaHandle != INVALID_HANDLE)
      IndicatorRelease(g_mtfEmaHandle);
   if(g_currentTfEmaHandle != INVALID_HANDLE)
      IndicatorRelease(g_currentTfEmaHandle);

   ObjectDelete(0, DASH_BG_NAME);
   for(int i = 0; i < 6; i++)
      ObjectDelete(0, DASH_OBJ_NAME + "_L" + IntegerToString(i));
  }

//+------------------------------------------------------------------+
void OnTick()
  {
   // สำคัญ: indicator ที่โหลดผ่าน iCustom จะ "คำนวณใหม่" ก็ต่อเมื่อมีการ
   // ขอข้อมูลจากมันเท่านั้น (pull-based) การเรียก CopyBuffer แม้จะทิ้งค่า
   // ที่ได้ ก็เป็นการบังคับให้ indicator รัน OnCalculate() ของมันเอง
   // ซึ่งจะไปวาด/อัปเดต signal object ให้ EA อ่านต่อได้
   double dummy[1];
   CopyBuffer(g_indiHandle, 0, 0, 1, dummy);

   // อัปเดตสถานะ basket ที่ยังเปิดอยู่เสมอ (ใช้จำกัดจำนวนชุดพร้อมกัน)
   // ต้องรันก่อน ManageMartingale และไม่ว่าจะเปิดมาร์ติงเกลหรือไม่ก็ตาม
   UpdateBasketLifecycle();

   // จัดการระบบมาร์ติงเกลทุก tick (ไม่ว่าจะมีสัญญาณใหม่หรือไม่)
   ManageMartingale();

   // จัดการระบบจับคู่ปิด (Pair-Close) แยกอิสระจากมาร์ติงเกลด้านบนโดยสิ้นเชิง
   ManagePairClose();

   // อัปเดต Daily Dashboard (เช็ค rollover วันใหม่ + วาดสรุปผลบนกราฟ)
   CheckDailyCounterRollover();
   UpdateDailyDashboard();

   string latestName;
   if(!GetLatestSignalObject(latestName))
      return; // ยังไม่มีสัญญาณบนกราฟเลย

   if(latestName == g_lastProcessedSignal)
      return; // สัญญาณนี้เปิดออเดอร์ไปแล้ว หรือเป็น baseline เดิม

   // ป้องกัน REPAINT: เปิดออเดอร์เฉพาะสัญญาณที่เกิดบนแท่งที่ "ปิดแล้ว" เท่านั้น
   // ถ้าสัญญาณอยู่บนแท่งปัจจุบันที่ยังไม่ปิด indicator อาจลบ/เปลี่ยนมันทีหลัง
   // ก็แค่รอไปก่อน ยังไม่ต้อง mark ว่าประมวลผลแล้ว เผื่อรอบหน้ามันหายไปแล้ว
   // ค่อยเจอสัญญาณใหม่อื่นแทน
   long signalBarTime = ExtractSignalTime(latestName);
   long currentBarOpenTime = (long)iTime(_Symbol, _Period, 0);
   if(signalBarTime >= currentBarOpenTime)
      return; // สัญญาณอยู่บนแท่งที่ยังไม่ปิด รอแท่งถัดไปก่อน

   // เซฟตี้ชั้นที่สอง: กันสัญญาณ "ค้างเก่า" หลุดผ่าน baseline มาได้ (เช่น race condition
   // ตอนเริ่ม EA) ถ้าสัญญาณเก่าเกิน InpMaxSignalAgeBars แท่ง จะไม่เปิดออเดอร์ตามเลย
   // แต่ยัง mark ว่าประมวลผลแล้ว (ข้ามไปเฉย ๆ ไม่ต้องแจ้งเตือนซ้ำทุก tick)
   long periodSeconds = (long)PeriodSeconds(_Period);
   long maxAgeSeconds  = periodSeconds * InpMaxSignalAgeBars;
   if((currentBarOpenTime - signalBarTime) > maxAgeSeconds)
     {
      Print("BTW_Signal_EA: ข้ามสัญญาณเก่า ", latestName,
            " (เก่ากว่า ", InpMaxSignalAgeBars, " แท่ง) ไม่เปิดออเดอร์");
      g_lastProcessedSignal = latestName;
      return;
     }

   // มาร์คว่าเห็นสัญญาณนี้แล้ว (กันไม่ให้ลูปยิงซ้ำ แม้ว่าจะเปิดออเดอร์ไม่สำเร็จ)
   g_lastProcessedSignal = latestName;

   ProcessSignal(latestName);
  }

