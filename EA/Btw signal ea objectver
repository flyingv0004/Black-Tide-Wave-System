//| v1.20: ส่ง Alert + Push Notification แจ้งเตือนเหตุการณ์ผิดปกติที่  |
//| ต้องการให้ผู้ใช้รับรู้ (เปิด/ปิดไม้ล้มเหลว, pending ค้าง ฯลฯ)       |
//| แม้ EA จะยังทำงานเปิดซ้ำอัตโนมัติในพื้นหลังต่อไปก็ตาม              |
//| SendNotification จะทำงานก็ต่อเมื่อผู้ใช้ตั้งค่า MetaQuotes ID ไว้   |
//| ใน Terminal (Tools > Options > Notifications) ถ้าไม่ได้ตั้งไว้     |
//| จะแค่ล้มเหลวเงียบ ๆ ไม่กระทบการทำงานอื่นของ EA                    |
//+------------------------------------------------------------------+
void TriggerAlert(string msg)
  {
   string fullMsg = "BTW_Signal_EA (" + _Symbol + "): " + msg;
   Alert(fullMsg);
   SendNotification(fullMsg);
  }

//+------------------------------------------------------------------+
//| v1.20: พยายามเปิดไม้ทดแทนที่ค้างอยู่ในคิว (Pending Replacement)    |
//| ของ basket ที่ระบุ เรียกทุก tick จาก ManagePairClose ถ้ามี         |
//| pendingReplacement=true พยายามเปิดซ้ำไม่จำกัดจำนวนครั้งจนกว่าจะ    |
//| สำเร็จ พร้อม Alert เตือนซ้ำเป็นระยะ (คุมความถี่ด้วย                |
//| InpPendingAlertIntervalSec) ไม่สแปมทุก tick                       |
//+------------------------------------------------------------------+
void ProcessPendingReplacement(MartingaleBasket &b)
  {
   if(!b.pendingReplacement)
      return;

   double lot = NormalizeLot(b.pendingLot);
   if(lot <= 0)
     {
      // แทบเป็นไปไม่ได้ในทางปฏิบัติ (lot ผ่าน NormalizeLot มาแล้วตอนคำนวณครั้งแรก)
      // แต่กันไว้เผื่อ broker เปลี่ยน volume step ระหว่างทาง — log เตือนแล้วรอ ๆ ไป
      // โดยไม่ล็อกตัวเองเป็น infinite Print (ใช้ alert interval เดียวกันคุมความถี่)
      uint nowZero = GetTickCount();
      if(b.pendingLastAlertTick == 0 || (nowZero - b.pendingLastAlertTick) >= (uint)(InpPendingAlertIntervalSec * 1000))
        {
         Print("BTW_Signal_EA: [WARNING] Pending replacement basket=", b.basketId,
               " lot ที่คำนวณได้เป็น 0 (broker เปลี่ยน volume step?) ไม่สามารถเปิดไม้ทดแทนได้ กรุณาตรวจสอบด้วยตนเอง");
         TriggerAlert("Pending replacement Basket=" + b.basketId + " lot=0 ผิดปกติ กรุณาตรวจสอบ");
         b.pendingLastAlertTick = nowZero;
        }
      return;
     }

   string cmt = b.basketId + "|" + InpOrderComment + "-PCR"; // PCR = Pair-Close Replacement (retry)
   bool ok;
   if(b.pendingIsBuy)
      ok = trade.Buy(lot, _Symbol, 0, 0, 0, cmt);
   else
      ok = trade.Sell(lot, _Symbol, 0, 0, 0, cmt);

   if(ok)
     {
      double fillPrice = trade.ResultPrice();
      if(fillPrice <= 0)
         fillPrice = b.pendingIsBuy ? SymbolInfoDouble(_Symbol, SYMBOL_ASK) : SymbolInfoDouble(_Symbol, SYMBOL_BID);

      Print("BTW_Signal_EA: Pending replacement เปิดสำเร็จ basket=", b.basketId,
            " lot=", lot, " @", DoubleToString(fillPrice, _Digits), " (รอมาแล้วตั้งแต่ tick=", b.pendingFirstAttemptTick, ")");

      UpdateNextTriggerFromFill(b, fillPrice);

      b.pendingReplacement      = false;
      b.pendingLot              = 0.0;
      b.pendingFirstAttemptTick = 0;
      b.pendingLastAlertTick    = 0;
     }
   else
     {
      uint now = GetTickCount();
      if(b.pendingLastAlertTick == 0 || (now - b.pendingLastAlertTick) >= (uint)(InpPendingAlertIntervalSec * 1000))
        {
         Print("BTW_Signal_EA: [WARNING] ไม้ทดแทน Pair-Close basket=", b.basketId,
               " ยังเปิดไม่สำเร็จ (err=", GetLastError(), ") กำลังพยายามเปิดซ้ำทุก tick ต่อเนื่องอัตโนมัติ ไม่จำกัดจำนวนครั้ง");
         TriggerAlert("Pending replacement ค้าง Basket=" + b.basketId + " (err=" + IntegerToString(GetLastError()) + ") กำลังพยายามเปิดซ้ำอัตโนมัติ");
         b.pendingLastAlertTick = now;
        }
     }
  }

// v1.20: safety cap กันจับคู่/เปิดไม้ทดแทนวนไม่รู้จบภายใน tick เดียว
// (ในทางปฏิบัติแทบเป็นไปไม่ได้ที่จะวนเกินนี้ เว้นแต่ตั้ง InpMartingaleMaxLevels
// สูงผิดปกติมาก ค่านี้กันไว้เฉย ๆ)
#define PAIRCLOSE_MAX_ITER_PER_BASKET 50

//+------------------------------------------------------------------+
//| ระบบจับคู่ปิด (Pair-Close) v1.20:                                 |
//| "ไม้ใหม่สุด" ไล่จับคู่กับไม้อื่นทุกตัวในตะกร้า (เรียงเก่าสุด->      |
//| ใหม่สุด เจอคู่แรกที่ถึงเป้ากำไรก่อนใช้เลย) แทนที่จะจับคู่ได้แค่     |
//| เก่าสุด+ใหม่สุดสองปลายแบบเดิม วนซ้ำหลายคู่ต่อเนื่องได้ภายใน tick   |
//| เดียวกัน (มี safety cap) และถ้าปิดคู่แล้วไม่เหลือไม้อื่นในตะกร้าเลย |
//| จะไม่เปิดไม้ทดแทนอีก ปล่อยให้ basket จบสมบูรณ์ ไม่ค้างไม้ไว้        |
//| ถ้าปิดคู่สำเร็จแต่เปิดไม้ทดแทนล้มเหลว จะเข้าคิว Pending            |
//| Replacement แทนที่จะปล่อยสล็อตหายไปเฉย ๆ                          |
//| ทำงานแยกอิสระจากระบบ Grid-trigger และปิดทั้งชุดด้านบน แต่ v1.20    |
//| เปลี่ยนจาก "ไม่แก้ nextTriggerPrice เลย" เป็น "อัปเดต               |
//| nextTriggerPrice จากราคาเปิดจริงของไม้ทดแทน" ตามที่ตกลงกันไว้      |
//| (ไม่แตะ gridLevel เหมือนเดิม — gridLevel ยังนับเฉพาะไม้แก้กริดปกติ) |
//+------------------------------------------------------------------+
void ManagePairClose()
  {
   if(!InpPairCloseEnabled)
      return;

   for(int i = ArraySize(g_baskets) - 1; i >= 0; i--)
     {
      if(!g_baskets[i].active)
         continue;

      // 1) พยายามเปิดไม้ทดแทนที่ค้างอยู่ในคิว (ถ้ามี) ก่อนเสมอทุก tick
      //    ไม่ว่า gridLevel จะถึง InpPairCloseStartLevel หรือไม่ก็ตาม (pending
      //    เกิดได้ก็ต่อเมื่อผ่านจุดนั้นมาแล้วเท่านั้น เช็คนี้จึงไม่มีวันถูกข้าม)
      if(g_baskets[i].pendingReplacement)
         ProcessPendingReplacement(g_baskets[i]);

      // เริ่มจับคู่ปิดก็ต่อเมื่อ basket นี้เปิดไม้แก้ไปแล้วอย่างน้อยตามที่ตั้งไว้
      if(g_baskets[i].gridLevel < InpPairCloseStartLevel)
         continue;

      int iterCount = 0;
      while(iterCount < PAIRCLOSE_MAX_ITER_PER_BASKET)
        {
         iterCount++;

         ulong tickets[];
         if(!GetBasketOpenTicketsSorted(g_baskets[i].basketId, tickets))
            break; // ไม้เหลือไม่ถึง 2 ตัว จับคู่ไม่ได้แล้ว

         int cnt = ArraySize(tickets);
         ulong newestTicket = tickets[cnt - 1];

         if(!PositionSelectByTicket(newestTicket))
            break;
         double newestProfit = PositionGetDouble(POSITION_PROFIT) + PositionGetDouble(POSITION_SWAP);
         double newestVolume = PositionGetDouble(POSITION_VOLUME);

         bool  foundPair    = false;
         ulong matchedTicket = 0;
         double pairProfit   = 0;

         // ไล่จากเก่าสุด -> ใหม่สุด (ไม่รวมตัวเอง) เจอคู่แรกที่ถึงเป้ากำไรก่อนใช้เลย
         for(int k = 0; k < cnt - 1; k++)
           {
            ulong candTicket = tickets[k];
            if(!PositionSelectByTicket(candTicket)) continue;
            double candProfit = PositionGetDouble(POSITION_PROFIT) + PositionGetDouble(POSITION_SWAP);

            double totalProfit = candProfit + newestProfit;
            if(totalProfit >= InpPairCloseProfitUSD)
              {
               foundPair     = true;
               matchedTicket = candTicket;
               pairProfit    = totalProfit;
               break;
              }
           }

         if(!foundPair)
            break; // ไม่มีคู่ไหนถึงเป้าแล้วในรอบนี้ จบการจับคู่ของ basket นี้ใน tick นี้

         // ปิดคู่ที่เจอ: matchedTicket (ไม้อื่นที่จับคู่ได้) + newestTicket (ใหม่สุด)
         bool closedOldOk = trade.PositionClose(matchedTicket);
         bool closedNewOk = trade.PositionClose(newestTicket);

         if(!closedOldOk || !closedNewOk)
           {
            // v1.20: เช็คผลการปิดจริง ถ้าปิดสำเร็จแค่บางส่วน (หรือทั้งคู่ล้มเหลว) ห้าม
            // นับ pairProfit เป็น realized และห้ามเปิดไม้ทดแทน เพราะสถานะจริงยังไม่ชัดเจน
            // ปล่อยให้ tick ถัดไป query สถานะสดจาก broker ใหม่ทั้งหมดแทนการเดา
            Print("BTW_Signal_EA: [CRITICAL] Pair-Close ปิดไม้ไม่สำเร็จบางส่วน basket=", g_baskets[i].basketId,
                  " ticket#", matchedTicket, "(", (closedOldOk ? "OK" : "FAIL"), ") ticket#", newestTicket,
                  "(", (closedNewOk ? "OK" : "FAIL"), ") err=", GetLastError(),
                  " — หยุดจับคู่รอบนี้ รอ tick ถัดไปประเมินสถานะจริงใหม่");
            TriggerAlert("Pair-Close ปิดไม้ล้มเหลวบางส่วน Basket=" + g_baskets[i].basketId + " กรุณาตรวจสอบทันที");
            break;
           }

         Print("BTW_Signal_EA: Pair-Close basket=", g_baskets[i].basketId,
               " ปิดคู่ #", matchedTicket, " + newest#", newestTicket,
               " กำไรรวม=", DoubleToString(pairProfit, 2), " USD (เป้า=", InpPairCloseProfitUSD, ")");

         // ปิดสำเร็จจริงแล้ว นับเป็น realized profit สะสมของ basket นี้
         g_baskets[i].realizedProfit += pairProfit;

         int remainingCount = cnt - 2;
         if(remainingCount <= 0)
           {
            // v1.20: ปิดคู่นี้แล้วไม่เหลือไม้อื่นในตะกร้าเลย -> เคลียร์จบสมบูรณ์
            // ไม่ต้องเปิดไม้ทดแทน กันไม่ให้ basket ค้างไม้ 1 ตัวไว้เสมอแบบของเดิม
            Print("BTW_Signal_EA: Pair-Close basket=", g_baskets[i].basketId,
                  " เคลียร์ไม้หมดตะกร้าแล้ว (ไม่เปิดไม้ทดแทน) basket จบสมบูรณ์");
            g_baskets[i].active             = false;
            g_baskets[i].pendingReplacement = false;
            SaveAllGridLevelsToFile(); // v1.25: rewrite ไฟล์ทันที กัน basket ที่จบแล้วเหลือเป็นเศษค้างในไฟล์นาน
            break;
           }

         // ยังมีไม้อื่นเหลืออยู่ในตะกร้า -> เปิดไม้ทดแทน lot เท่ากับไม้ใหม่สุดที่เพิ่งปิดไป
         // เพื่อรักษาขนาด "กระสุน" เดิมไว้ไล่จับคู่กับไม้ที่เหลือต่อ
         double lot = NormalizeLot(newestVolume);
         if(lot <= 0)
           {
            Print("BTW_Signal_EA: Pair-Close lot คำนวณได้ 0 ข้ามการเปิดไม้ทดแทน basket=", g_baskets[i].basketId);
            break;
           }

         string cmt = g_baskets[i].basketId + "|" + InpOrderComment + "-PC";
         bool ok;
         if(g_baskets[i].isBuy)
            ok = trade.Buy(lot, _Symbol, 0, 0, 0, cmt);
         else
            ok = trade.Sell(lot, _Symbol, 0, 0, 0, cmt);

         if(ok)
           {
            double fillPrice = trade.ResultPrice();
            if(fillPrice <= 0)
               fillPrice = g_baskets[i].isBuy ? SymbolInfoDouble(_Symbol, SYMBOL_ASK) : SymbolInfoDouble(_Symbol, SYMBOL_BID);

            // v1.20: อัปเดต nextTriggerPrice ของกริดมาร์ติงเกลจากราคาเปิดจริงของไม้
            // ทดแทนนี้ ± Gap (ไม่แตะ gridLevel) ตามที่ตกลงกันไว้ กันไม่ให้ไม้แก้
            // ถัดไปยิ่งห่างออกไปเรื่อย ๆ เมื่อ Pair-Close แทรกหลายรอบ
            UpdateNextTriggerFromFill(g_baskets[i], fillPrice);

            Print("BTW_Signal_EA: Pair-Close เปิดไม้ทดแทน basket=", g_baskets[i].basketId,
                  " lot=", lot, " @", DoubleToString(fillPrice, _Digits));
            // วนต่อทันทีใน tick เดียวกัน (safety cap คุมอยู่) เผื่อจับคู่ต่อได้อีก
           }
         else
           {
            // v1.20: ปิดคู่สำเร็จแล้วแต่เปิดไม้ทดแทนล้มเหลว -> ไม่ปล่อยสล็อตหายไปเฉย ๆ
            // เข้าคิว Pending Replacement ให้พยายามเปิดซ้ำอัตโนมัติทุก tick ต่อไป
            // ไม่จำกัดจำนวนครั้ง แล้วหยุดจับคู่รอบนี้ก่อน (รอ pending resolve)
            Print("BTW_Signal_EA: [WARNING] Pair-Close เปิดไม้ทดแทนล้มเหลว basket=", g_baskets[i].basketId,
                  " err=", GetLastError(), " — เข้าคิวรอเปิดซ้ำอัตโนมัติทุก tick จนกว่าจะสำเร็จ");
            g_baskets[i].pendingReplacement      = true;
            g_baskets[i].pendingIsBuy            = g_baskets[i].isBuy;
            g_baskets[i].pendingLot              = lot;
            g_baskets[i].pendingFirstAttemptTick = GetTickCount();
            g_baskets[i].pendingLastAlertTick    = 0; // 0 = บังคับให้แจ้งเตือนทันทีในครั้งแรก
            TriggerAlert("Pair-Close เปิดไม้ทดแทนล้มเหลว Basket=" + g_baskets[i].basketId + " กำลังพยายามเปิดซ้ำอัตโนมัติ");
            break;
           }
        }

      if(iterCount >= PAIRCLOSE_MAX_ITER_PER_BASKET)
         Print("BTW_Signal_EA: [WARNING] Pair-Close basket=", g_baskets[i].basketId,
               " ถึง safety cap ของจำนวนรอบต่อ tick (", PAIRCLOSE_MAX_ITER_PER_BASKET, ") หยุดไว้ก่อน จะทำต่อ tick ถัดไป");
     }
  }

//+------------------------------------------------------------------+
//| นับจำนวนไม้ที่ยังเปิดอยู่ของ basket ที่ระบุ                        |
//+------------------------------------------------------------------+
int CountBasketOpenPositions(const string basketId)
  {
   int count = 0;
   int total = PositionsTotal();
   for(int i = 0; i < total; i++)
     {
      ulong ticket = PositionGetTicket(i);
      if(ticket == 0) continue;
      if(!PositionSelectByTicket(ticket)) continue;
      if(PositionGetInteger(POSITION_MAGIC) != InpMagic) continue;
      if(PositionGetString(POSITION_SYMBOL) != _Symbol) continue; // v1.20 symbol-safety
      string cmt = PositionGetString(POSITION_COMMENT);
      if(StringFind(cmt, basketId) != 0) continue; // comment ต้องขึ้นต้นด้วย basketId
      count++;
     }
   return count;
  }

//+------------------------------------------------------------------+
//| รวม Lot ของไม้ที่ยังเปิดอยู่จริงทั้งหมดใน basket ที่ระบุ (ใช้เป็นฐาน|
//| คำนวณขนาดไม้แก้ชั้นถัดไป ให้สมส่วนกับสิ่งที่ยังเสี่ยงอยู่จริง)      |
