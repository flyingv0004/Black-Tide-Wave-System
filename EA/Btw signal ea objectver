//--- Wingdings code ที่ indicator ใช้ (ต้องตรงกับ ENUM_ARROW_CHAR ใน indicator)
#define BTW_ARROW_BUY   233
#define BTW_ARROW_SELL  234

// ตัวเลือก Timeframe สำหรับ MTF EMA200 Filter (จำกัดแค่ 5 ตัวตามที่ต้องการ)
enum ENUM_MTF_CHOICE
  {
   MTF_TF_M15 = 0, // M15
   MTF_TF_M30 = 1, // M30
   MTF_TF_H1  = 2, // H1
   MTF_TF_H4  = 3, // H4
   MTF_TF_D1  = 4  // D1
  };

input group    "=== Signal Source ==="
input string   InpObjPrefix       = "BTW_";   // Prefix ของ Object (ต้องตรงกับตัวแปร g_P ใน indicator)
input string   InpIndicatorName   = "BTW v794-7 - TEST"; // ชื่อไฟล์ indicator ตามที่เห็นใน Navigator (ไม่ต้องใส่ .ex5)
input int      InpMaxSignalAgeBars = 2;       // สัญญาณต้องไม่เก่ากว่ากี่แท่งเทียนจากปัจจุบัน (กันสัญญาณค้างเก่าตอนเริ่ม EA)

input group    "=== Money Management ==="
input double   InpLotTotal        = 0.10;     // Lot รวมต่อสัญญาณ (แบ่งเป็น TP1+TP2)
input double   InpTP1Percent      = 70.0;     // % Lot สำหรับไม้ TP1
input double   InpTP2Percent      = 30.0;     // % Lot สำหรับไม้ TP2

input group    "=== MTF EMA200 Trend Filter ==="
input bool          InpUseMTFFilter    = false;      // เปิด/ปิดตัวกรอง EMA200 จาก Timeframe ที่ใหญ่กว่า
input ENUM_MTF_CHOICE InpMTFTimeframe  = MTF_TF_H1;   // เลือก Timeframe ที่จะใช้เช็ค EMA200
input double        InpMTFDeadZoneUSD = 30.0;       // ระยะห่างจาก EMA ที่ถือว่า "ก้ำกึ่ง" (USD) ถ้าราคาอยู่ในโซนนี้จะไม่เปิดไม้เลยจนกว่าจะคอนเฟิมข้าง
input bool          InpMTFBlockCandleStraddle = false; // เพิ่มเติม: บล็อกถ้าแท่งเทียน (High/Low) ของ TF นี้คาบเส้น EMA200 อยู่ (เส้นพาดผ่านลำตัว/ไส้เทียน) ไม่ว่าราคาปิดจะห่างแค่ไหนก็ตาม

input group    "=== Current-TF EMA200 Trend Filter ==="
input bool          InpUseCurrentTFFilter    = false; // เปิด/ปิดตัวกรอง EMA200 บน Timeframe ปัจจุบันที่ EA รันอยู่ (คนละตัวกับ MTF ด้านบน เปิดพร้อมกันได้ = ดับเบิ้ลเช็ค)
input double        InpCurrentTFDeadZoneUSD = 30.0;  // ระยะห่างจาก EMA ที่ถือว่า "ก้ำกึ่ง" (USD) สำหรับ Timeframe ปัจจุบัน (แยกค่าจาก MTF ด้านบน)
input bool          InpCurrentTFBlockCandleStraddle = false; // เพิ่มเติม: บล็อกถ้าแท่งเทียนของ Timeframe ปัจจุบันคาบเส้น EMA200 อยู่

input group    "=== Order Management ==="
input int      InpMagic           = 20260831; // Magic Number คุมทุกออเดอร์ที่ EA นี้เปิด
input int      InpSlippage        = 20;       // Slippage (points)
input string   InpOrderComment    = "BTW-Signal"; // Comment ของออเดอร์ (แสดงต่อจาก Basket ID)
input int      InpMaxConcurrentBaskets = 0;    // จำนวนชุด(สัญญาณ)ที่เปิดพร้อมกันได้สูงสุด (0 = ไม่จำกัด) เช่น 1 = ต้องรอชุดเดิมปิดหมดก่อนถึงเปิดสัญญาณใหม่ได้

input group    "=== Martingale Recovery (แก้ไม้) ==="
input bool     InpMartingaleEnabled     = false;                // เปิด/ปิดระบบแก้ไม้มาร์ติงเกล
input string   InpMartingaleMultipliers = "1.0,1.5,2.0,2.5,3.0"; // เท่าของ Lot รวมเดิม แต่ละชั้น (คั่นด้วย , ชั้นที่ 1 อยู่ซ้ายสุด) ถ้าใส่ตัวเดียวจะใช้ค่านั้นซ้ำทุกชั้น
input int      InpMartingaleMaxLevels   = 5;                     // จำนวนชั้นสูงสุดที่จะแก้ไม้ (safety cap กันแก้ไม่มีที่สิ้นสุด)
input double   InpMartingaleGapUSD      = 20.0;                  // ระยะห่างราคาระหว่างไม้แก้แต่ละชั้น หน่วย USD (ใส่เองได้อิสระ ใช้ค่าเดียวกันทุกชั้น)
input double   InpMartingaleCloseProfitUSD = 1.0;                // ปิดกำไรด่วนทั้งชุด เมื่อกำไรลอยรวมของชุดที่ถูกแก้ไม้ >= ค่านี้ (USD)

input group    "=== Pair-Close Recovery (จับคู่ปิด: ไม้ใหม่สุด ไล่จับคู่ไม้อื่นทั้งหมด) ==="
input bool     InpPairCloseEnabled      = false; // เปิด/ปิดระบบจับคู่ปิด (ทำงานแยกจากระบบปิดทั้งชุดด้านบน อิสระต่อกัน)
input int      InpPairCloseStartLevel   = 2;     // เริ่มจับคู่ปิดก็ต่อเมื่อ basket มีไม้แก้เปิดไปแล้วอย่างน้อยกี่ชั้น (gridLevel >= ค่านี้)
input double   InpPairCloseProfitUSD    = 1.0;   // กำไรขั้นต่ำของคู่ (ไม้ใหม่สุด + ไม้อื่นที่เลือกจับคู่ได้) ที่จะสั่งปิดคู่ทันที (USD)
input int      InpPendingAlertIntervalSec = 300; // ถ้าเปิดไม้ทดแทนล้มเหลวและต้องรอคิวเปิดซ้ำ จะแจ้งเตือนซ้ำทุกกี่วินาที (EA จะพยายามเปิดซ้ำทุก tick อยู่แล้วไม่จำกัดจำนวนครั้ง ค่านี้คุมแค่ความถี่ Alert)

input group    "=== Daily Dashboard ==="
input bool     InpShowDailyDashboard = true;  // แสดงสรุปผลรวมประจำวันบนกราฟ
input bool     InpUseThaiTime        = true;  // นับ "วัน" แบบเวลาไทย (เทียบจากเวลาเครื่องอัตโนมัติ) ถ้าปิดจะใช้เวลา server แทน
input bool     InpDebugDashboard     = true;  // พิมพ์รายละเอียดขอบเขตเวลา/deal ที่นับได้ลง Journal (ใช้ดีบักเมื่อยอดไม่ตรง ปิดได้ทีหลัง)

