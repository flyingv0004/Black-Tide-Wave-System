//| v1.20: ใช้ symbol เต็มแทนการตัดเหลือ 3 ตัวอักษรแรกแบบเดิม เพราะ    |
//| ถ้ารันหลายคู่เงินที่ตัวอักษรนำหน้าเหมือนกัน (เช่น EURUSD/EURJPY/    |
//| EURGBP ตัดแล้วเหลือ "EUR" เหมือนกันหมด) ด้วย Magic Number ซ้ำกัน   |
//| (เผลอตั้งผิดในอนาคต) basketId จะชนกันได้ถ้าสัญญาณเกิดแท่งเวลา      |
//| เดียวกันพอดี ใช้ symbol เต็มช่วยลดโอกาสชนกันตั้งแต่ต้นทาง          |
//| (ดู symbol-safety check เพิ่มเติมในฟังก์ชันกวาดหาไม้ของ basket     |
//| แต่ละตัวด้านล่าง เป็นเกราะป้องกันชั้นที่สอง)                       |
//+------------------------------------------------------------------+
string GetChartTag()
  {
   return _Symbol + "_" + IntegerToString((int)_Period);
  }

//+------------------------------------------------------------------+
//| แกะเวลาของแท่งเทียนออกจากชื่อ object เช่น "BTW_SIG_1788132000"    |
//+------------------------------------------------------------------+
long ExtractSignalTime(const string signalName)
  {
   string searchPrefix = InpObjPrefix + "SIG_";
   string suffix = StringSubstr(signalName, StringLen(searchPrefix));
   return (long)StringToInteger(suffix);
  }

//+------------------------------------------------------------------+
//| แปลงตัวเลือกจาก enum ที่จำกัดไว้ (5 ตัว) ไปเป็น ENUM_TIMEFRAMES จริง|
//+------------------------------------------------------------------+
ENUM_TIMEFRAMES MapMTFTimeframe(ENUM_MTF_CHOICE choice)
  {
   switch(choice)
     {
      case MTF_TF_M15: return PERIOD_M15;
      case MTF_TF_M30: return PERIOD_M30;
      case MTF_TF_H1:  return PERIOD_H1;
      case MTF_TF_H4:  return PERIOD_H4;
      case MTF_TF_D1:  return PERIOD_D1;
     }
   return PERIOD_H1;
  }

//+------------------------------------------------------------------+
//| เช็คตัวกรอง MTF EMA200: อนุญาตให้เปิดออเดอร์ตามทิศทางที่ตรงกับ     |
//| ตำแหน่งราคาเทียบ EMA200 ของ Timeframe ที่ใหญ่กว่าเท่านั้น          |
//| - ราคาอยู่เหนือ EMA (เกิน dead zone) -> อนุญาตเฉพาะ Buy            |
//| - ราคาอยู่ใต้ EMA (เกิน dead zone)   -> อนุญาตเฉพาะ Sell           |
//| - ราคาอยู่ในโซนก้ำกึ่ง (ใกล้ EMA ไม่เกิน dead zone)  -> บล็อกทั้งคู่ |
//+------------------------------------------------------------------+
bool CheckMTFTrendFilter(bool isBuySignal)
  {
   if(!InpUseMTFFilter)
      return true; // ไม่ได้เปิดใช้ตัวกรอง ปล่อยผ่านทุกสัญญาณ

   if(g_mtfEmaHandle == INVALID_HANDLE)
     {
      Print("BTW_Signal_EA: MTF filter เปิดใช้อยู่แต่ EMA handle ใช้ไม่ได้ ข้ามสัญญาณนี้ไว้ก่อนเพื่อความปลอดภัย");
      return false;
     }

   double emaBuf[1];
   // อ่านที่ shift=1 ของ Timeframe ใหญ่ (แท่งปิดแล้ว) กันปัญหา repaint ของแท่งที่ยังไม่ปิด
   if(CopyBuffer(g_mtfEmaHandle, 0, 1, 1, emaBuf) <= 0)
     {
      Print("BTW_Signal_EA: อ่านค่า EMA200 MTF ไม่ได้ ข้ามสัญญาณนี้ไว้ก่อนเพื่อความปลอดภัย");
      return false;
     }

   double ema = emaBuf[0];

   // เช็คเพิ่มเติม (ถ้าเปิดใช้): แท่งเทียนของ TF นี้ "คาบเส้น" EMA200 อยู่หรือไม่
   // (High >= EMA และ Low <= EMA แปลว่าเส้นพาดผ่านลำตัว/ไส้เทียนพอดี) ถ้าใช่ บล็อกทันที
   // ไม่ว่าราคาปิดจะห่างจากเส้นแค่ไหนก็ตาม เพราะถือว่าแท่งนั้นยังไม่ชัดเจนพอ
   if(InpMTFBlockCandleStraddle)
     {
      ENUM_TIMEFRAMES mtfTf = MapMTFTimeframe(InpMTFTimeframe);
      double high1 = iHigh(_Symbol, mtfTf, 1);
      double low1  = iLow(_Symbol, mtfTf, 1);
      if(high1 >= ema && low1 <= ema)
        {
         Print("BTW_Signal_EA: แท่งเทียน MTF คาบเส้น EMA200 อยู่ (High=", high1, " Low=", low1, " EMA=", ema, ") ข้ามสัญญาณนี้");
         return false;
        }
     }

   double currentPrice = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   double diff = currentPrice - ema;

   if(MathAbs(diff) <= InpMTFDeadZoneUSD)
     {
      Print("BTW_Signal_EA: ราคาอยู่ในโซนก้ำกึ่งของ EMA200 MTF (diff=", DoubleToString(diff, 2),
            " deadzone=", InpMTFDeadZoneUSD, ") รอคอนเฟิมทิศทางก่อน ข้ามสัญญาณนี้");
      return false;
     }

   bool aboveEma = (diff > 0);
   if(aboveEma && !isBuySignal)
     {
      Print("BTW_Signal_EA: MTF filter บล็อกสัญญาณ Sell เพราะราคาอยู่เหนือ EMA200 MTF (diff=", DoubleToString(diff, 2), ")");
      return false;
     }
   if(!aboveEma && isBuySignal)
     {
      Print("BTW_Signal_EA: MTF filter บล็อกสัญญาณ Buy เพราะราคาอยู่ใต้ EMA200 MTF (diff=", DoubleToString(diff, 2), ")");
      return false;
     }

   return true; // ทิศทางตรงกับแนวโน้ม MTF อนุญาตให้เปิดได้
  }

//+------------------------------------------------------------------+
//| เช็คตัวกรอง EMA200 บน Timeframe ปัจจุบัน (หลักการเดียวกับ MTF      |
//| ทุกอย่าง แต่ใช้ Timeframe เดียวกับที่ EA รันอยู่ ไม่ใช่ TF ที่ใหญ่กว่า)|
//+------------------------------------------------------------------+
bool CheckCurrentTFTrendFilter(bool isBuySignal)
  {
   if(!InpUseCurrentTFFilter)
      return true; // ไม่ได้เปิดใช้ตัวกรองนี้ ปล่อยผ่าน

   if(g_currentTfEmaHandle == INVALID_HANDLE)
     {
      Print("BTW_Signal_EA: Current-TF filter เปิดใช้อยู่แต่ EMA handle ใช้ไม่ได้ ข้ามสัญญาณนี้ไว้ก่อนเพื่อความปลอดภัย");
      return false;
     }

   double emaBuf[1];
   // อ่านที่ shift=1 ของ Timeframe ปัจจุบัน (แท่งปิดแล้ว) กันปัญหา repaint เช่นเดียวกับ MTF
   if(CopyBuffer(g_currentTfEmaHandle, 0, 1, 1, emaBuf) <= 0)
     {
      Print("BTW_Signal_EA: อ่านค่า EMA200 Current-TF ไม่ได้ ข้ามสัญญาณนี้ไว้ก่อนเพื่อความปลอดภัย");
      return false;
     }

   double ema = emaBuf[0];

   // เช็คเพิ่มเติม (ถ้าเปิดใช้): แท่งเทียนของ Timeframe ปัจจุบัน "คาบเส้น" EMA200 อยู่หรือไม่
   if(InpCurrentTFBlockCandleStraddle)
     {
      double high1 = iHigh(_Symbol, _Period, 1);
      double low1  = iLow(_Symbol, _Period, 1);
      if(high1 >= ema && low1 <= ema)
        {
         Print("BTW_Signal_EA: แท่งเทียน Current-TF คาบเส้น EMA200 อยู่ (High=", high1, " Low=", low1, " EMA=", ema, ") ข้ามสัญญาณนี้");
         return false;
        }
     }

   double currentPrice = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   double diff = currentPrice - ema;

   if(MathAbs(diff) <= InpCurrentTFDeadZoneUSD)
     {
      Print("BTW_Signal_EA: ราคาอยู่ในโซนก้ำกึ่งของ EMA200 Current-TF (diff=", DoubleToString(diff, 2),
            " deadzone=", InpCurrentTFDeadZoneUSD, ") รอคอนเฟิมทิศทางก่อน ข้ามสัญญาณนี้");
      return false;
     }

   bool aboveEma = (diff > 0);
   if(aboveEma && !isBuySignal)
     {
      Print("BTW_Signal_EA: Current-TF filter บล็อกสัญญาณ Sell เพราะราคาอยู่เหนือ EMA200 Current-TF (diff=", DoubleToString(diff, 2), ")");
      return false;
     }
   if(!aboveEma && isBuySignal)
     {
      Print("BTW_Signal_EA: Current-TF filter บล็อกสัญญาณ Buy เพราะราคาอยู่ใต้ EMA200 Current-TF (diff=", DoubleToString(diff, 2), ")");
      return false;
     }

   return true;
  }

//+------------------------------------------------------------------+
//| อ่าน metadata จาก object แล้วเปิดออเดอร์ตามสัญญาณ                 |
//+------------------------------------------------------------------+
void ProcessSignal(const string signalName)
  {
   string metadata = ObjectGetString(0, signalName, OBJPROP_TEXT);
   string parts[];
   int n = StringSplit(metadata, ';', parts);
   if(n < 5)
     {
      Print("BTW_Signal_EA: metadata ของ ", signalName, " ไม่ครบ (", metadata, ")");
      return;
     }

   double entry = StringToDouble(parts[0]); // ไม่ได้ใช้เปิดตรง ๆ (เปิดที่ราคาตลาดปัจจุบัน) แต่เก็บไว้ log/reference
   double sl    = StringToDouble(parts[1]);
   double tp1   = StringToDouble(parts[2]);
   double tp2   = StringToDouble(parts[3]);
   double score = StringToDouble(parts[4]);

   long arrowCode = ObjectGetInteger(0, signalName, OBJPROP_ARROWCODE);
   bool isBuy = (arrowCode == BTW_ARROW_BUY);
   bool isSell = (arrowCode == BTW_ARROW_SELL);

   if(!isBuy && !isSell)
     {
      Print("BTW_Signal_EA: ", signalName, " arrow code ไม่ตรง Buy/Sell (", arrowCode, ")");
      return;
     }

   // เช็คตัวกรอง MTF EMA200 ก่อนเสมอ (ถ้าเปิดใช้งาน) ถ้าทิศทางไม่ตรงเทรนด์ใหญ่ ข้ามสัญญาณนี้ไปเลย
   if(!CheckMTFTrendFilter(isBuy))
      return;

   // เช็คตัวกรอง EMA200 ของ Timeframe ปัจจุบันด้วย (คนละตัวกับ MTF ด้านบน เปิดพร้อมกันได้
   // ทั้งคู่ = ดับเบิ้ลเช็ค ต้องผ่านทั้งสองเงื่อนไขถึงจะเปิดออเดอร์ได้)
   if(!CheckCurrentTFTrendFilter(isBuy))
      return;

   double lot1 = NormalizeLot(InpLotTotal * InpTP1Percent / 100.0);
   double lot2 = NormalizeLot(InpLotTotal * InpTP2Percent / 100.0);

   if(lot1 <= 0 && lot2 <= 0)
     {
      Print("BTW_Signal_EA: lot คำนวณได้เป็น 0 ทั้งคู่ ข้ามสัญญาณนี้");
      return;
     }

   // Basket ID = Symbol+Timeframe+timestamp ของแท่งสัญญาณ ใช้ผูกไม้ทั้งหมดในสัญญาณ
   // เดียวกัน (ทั้ง TP1/TP2 ตอนเปิด และไม้แก้มาร์ติงเกลที่จะตามมาทีหลัง)
   // สำคัญ: ต้องมี Symbol+Timeframe รวมอยู่ด้วย ไม่งั้นถ้าแนบ EA บนกราฟคนละ
   // Timeframe พร้อมกัน (เช่น M1 กับ M5) แท่งที่ "เวลาตรงกันพอดี" (เช่นนาทีที่ 5,10,15)
   // จะได้ basketId ซ้ำกัน ทำให้ EA เข้าใจผิดว่าเป็น basket เดียวกัน แล้วนับ lot
   // ของอีกกราฟหนึ่งปนเข้ามาด้วย (สาเหตุของ lot ไม้แก้ที่คำนวณผิดเพี้ยน)
   string basketId = GetChartTag() + "_" + IntegerToString(ExtractSignalTime(signalName));

   // จำกัดจำนวนชุด (สัญญาณ) ที่เปิดพร้อมกันได้สูงสุด: ถ้าชุดก่อนหน้ายังไม่ปิดหมด
   // (ทั้งไม้แรกและไม้แก้มาร์ติงเกลของมัน) จะไม่เปิดสัญญาณใหม่นี้เลย รอให้ชุดเดิม
   // ปิดครบก่อน (0 = ไม่จำกัด อนุญาตหลายชุดพร้อมกันได้)
   if(InpMaxConcurrentBaskets > 0)
     {
      int activeBaskets = CountActiveBaskets();
      if(activeBaskets >= InpMaxConcurrentBaskets)
        {
         Print("BTW_Signal_EA: ข้ามสัญญาณ ", signalName, " Basket=", basketId,
               " เพราะชุดก่อนหน้ายังไม่ปิดหมด (active=", activeBaskets, "/", InpMaxConcurrentBaskets, ")");
         return;
        }
     }

   Print("BTW_Signal_EA: New signal ", signalName,
         " Basket=", basketId,
         " Dir=", (isBuy ? "BUY" : "SELL"),
         " Entry=", entry, " SL=", sl, " TP1=", tp1, " TP2=", tp2, " Score=", score);

   // เมื่อเปิดใช้มาร์ติงเกล: ไม่วาง SL จริงกับ broker ให้ไม้ TP1/TP2 (ปล่อยให้ลอย
   // ติดลบต่อไปแทนที่จะถูกปิดขาดทุนจริง) เพราะถ้าปิดขาดทุนจริงไปแล้ว ฟังก์ชันคำนวณ
   // กำไรรวมของ basket จะไม่เห็นผลขาดทุนก้อนนั้นอีกเลย (นับแค่ไม้ที่ยังเปิดอยู่ตอนนี้)
   // ทำให้ระบบเข้าใจผิดว่า "กำไรรวมแท้จริง" ถึงเป้าทั้งที่จริงยังขาดทุนสุทธิอยู่
   // ถ้าไม่เปิดมาร์ติงเกล ยังคงวาง SL จริงตามปกติเพื่อป้องกันความเสี่ยง
   double slForOrder = InpMartingaleEnabled ? 0.0 : sl;

   // เปิดตามสัญญาณทันทีที่ราคาตลาดปัจจุบัน ไม่เช็คว่ามีไม้ค้างอยู่ก่อนหรือไม่
   if(isBuy)
     {
      if(lot1 > 0) trade.Buy(lot1, _Symbol, 0, slForOrder, tp1, basketId + "|" + InpOrderComment + "-TP1");
      if(lot2 > 0) trade.Buy(lot2, _Symbol, 0, slForOrder, tp2, basketId + "|" + InpOrderComment + "-TP2");
     }
   else
     {
      if(lot1 > 0) trade.Sell(lot1, _Symbol, 0, slForOrder, tp1, basketId + "|" + InpOrderComment + "-TP1");
      if(lot2 > 0) trade.Sell(lot2, _Symbol, 0, slForOrder, tp2, basketId + "|" + InpOrderComment + "-TP2");
     }

   // ลงทะเบียน basket ไว้เสมอ (ไม่ใช่แค่ตอนเปิดมาร์ติงเกล) เพราะใช้เป็นฐานนับ
   // จำนวนชุดที่เปิดพร้อมกันสำหรับ InpMaxConcurrentBaskets ด้วย ไม่ใช่แค่กริดมาร์ติงเกล
   RegisterBasket(isBuy, basketId, sl);
  }

//+------------------------------------------------------------------+
//| หา Object สัญญาณล่าสุดที่มีอยู่บนกราฟตอนนี้ (ชื่อ Prefix+"SIG_"+เวลา)|
//+------------------------------------------------------------------+
bool GetLatestSignalObject(string &outName)
  {
   string searchPrefix = InpObjPrefix + "SIG_";
   int searchLen = StringLen(searchPrefix);

   long bestTime = -1;
   string bestName = "";

   int total = ObjectsTotal(0, 0, OBJ_ARROW);
   for(int idx = 0; idx < total; idx++)
     {
      string name = ObjectName(0, idx, 0, OBJ_ARROW);
      if(StringSubstr(name, 0, searchLen) != searchPrefix)
         continue;

      string suffix = StringSubstr(name, searchLen);
      long t = (long)StringToInteger(suffix);
      if(t > bestTime)
        {
         bestTime = t;
         bestName = name;
        }
     }

   if(bestName == "")
      return false;

   outName = bestName;
   return true;
  }

//+------------------------------------------------------------------+
//| ปรับ lot ให้ตรงตาม step/min/max ของโบรกเกอร์จริง                  |
//| สำคัญสำหรับมาร์ติงเกล: multiplier เช่น 1.5, 2.5 อาจทำให้ lot มี    |
//| ทศนิยมไม่ลงตัวกับ Volume Step ของโบรกเกอร์ ถ้าปัดผิดจำนวนตำแหน่ง   |
//| ทศนิยม จะโดน broker reject "Invalid volume" ฟังก์ชันนี้จึงคำนวณ   |
//| จำนวนทศนิยมจาก SYMBOL_VOLUME_STEP จริง แทนที่จะ fix ไว้ที่ 2 ตำแหน่ง|
//+------------------------------------------------------------------+
double NormalizeLot(double lot)
  {
   double minLot  = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);
   double maxLot  = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MAX);
   double stepLot = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP);
   if(stepLot <= 0) stepLot = 0.01; // กันหารด้วย 0 กรณี broker ไม่ส่งค่ามา

   // ปัดลงให้เป็นจำนวนเท่าของ step (บวก epsilon เล็กน้อยกันปัญหา floating point
   // เช่น 0.07/0.01 อาจได้ 6.999999 แทนที่จะเป็น 7 พอดี)
   double steps = MathFloor(lot / stepLot + 0.0000001);
   lot = steps * stepLot;

   // หาจำนวนตำแหน่งทศนิยมจริงของ step (เช่น step=0.01 -> 2 ตำแหน่ง, step=0.1 -> 1, step=1 -> 0)
   int digits = 0;
   double temp = stepLot;
   while(MathAbs(temp - MathRound(temp)) > 0.0000001 && digits < 8)
     {
      temp *= 10;
      digits++;
     }
   lot = NormalizeDouble(lot, digits);

   if(lot < minLot) lot = 0; // น้อยกว่า min ให้ข้ามไม้นี้ (กัน broker reject)
   if(lot > maxLot) lot = maxLot;

   return lot;
  }

//+------------------------------------------------------------------+
//| แตกค่า string คั่นด้วย , ให้เป็น array ของ double                 |
//+------------------------------------------------------------------+
void ParseDoubleList(const string s, double &arr[])
  {
   string parts[];
   int n = StringSplit(s, ',', parts);
   ArrayResize(arr, n);
   for(int i = 0; i < n; i++)
      arr[i] = StringToDouble(parts[i]);
  }

//+------------------------------------------------------------------+
//| v1.24: กู้คืน basket ที่เปิดค้างอยู่จริงในตลาด กลับเข้า g_baskets[]  |
//| เรียกครั้งเดียวตอน OnInit() หลัง ArrayResize(g_baskets,0) เท่านั้น  |
//| สแกนไม้ที่เปิดอยู่จริง (กรอง Magic+Symbol เหมือนฟังก์ชันอื่น) จัด   |
//| กลุ่มตาม basketId ที่แกะจาก comment (รูปแบบ "<basketId>|<suffix>") |
//| แล้ว reconstruct isBuy / gridLevel / nextTriggerPrice / realizedProfit|
//| ให้ใกล้เคียงของเดิมที่สุดเท่าที่ข้อมูลจาก broker จะให้ได้            |
//+------------------------------------------------------------------+
void RecoverBasketsFromOpenPositions()
  {
   string groupIds[];

   int total = PositionsTotal();
   for(int i = 0; i < total; i++)
     {
      ulong ticket = PositionGetTicket(i);
      if(ticket == 0) continue;
      if(!PositionSelectByTicket(ticket)) continue;
      if(PositionGetInteger(POSITION_MAGIC) != InpMagic) continue;
      if(PositionGetString(POSITION_SYMBOL) != _Symbol) continue;

      string cmt = PositionGetString(POSITION_COMMENT);
      int sep = StringFind(cmt, "|");
      if(sep <= 0) continue; // comment ไม่ตรงรูปแบบของ EA นี้เลย ("basketId|suffix") ข้ามไปเฉย ๆ ไม่ error

      string basketId = StringSubstr(cmt, 0, sep);
      // basketId ของ EA ตัวนี้ต้องขึ้นต้นด้วย GetChartTag()+"_" เสมอ (กัน false-positive
      // จากไม้ manual หรือ comment อื่นที่บังเอิญมี "|" ปนอยู่แต่ไม่ใช่ของกราฟนี้จริง ๆ)
      if(StringFind(basketId, GetChartTag() + "_") != 0) continue;

      bool alreadyListed = false;
      for(int k = 0; k < ArraySize(groupIds); k++)
         if(groupIds[k] == basketId) { alreadyListed = true; break; }

      if(!alreadyListed)
        {
         int n = ArraySize(groupIds);
         ArrayResize(groupIds, n + 1);
         groupIds[n] = basketId;
        }
     }

   int recoveredCount = 0;

   for(int g = 0; g < ArraySize(groupIds); g++)
     {
      string basketId = groupIds[g];

      bool     isBuy           = true;
      bool     gotDir          = false;
      int      maxGridLevel    = 0;
      ulong    newestTicket    = 0;
      datetime newestTime      = 0;
      datetime oldestTime      = 0;
      double   newestFillPrice = 0.0;
      double   slFromOriginal  = 0.0;

      int total2 = PositionsTotal();
      for(int i = 0; i < total2; i++)
        {
         ulong ticket = PositionGetTicket(i);
         if(ticket == 0) continue;
         if(!PositionSelectByTicket(ticket)) continue;
         if(PositionGetInteger(POSITION_MAGIC) != InpMagic) continue;
         if(PositionGetString(POSITION_SYMBOL) != _Symbol) continue;
         string cmt = PositionGetString(POSITION_COMMENT);
         if(StringFind(cmt, basketId) != 0) continue;

         if(!gotDir)
           {
            isBuy  = (PositionGetInteger(POSITION_TYPE) == POSITION_TYPE_BUY);
            gotDir = true;
           }

         // แกะเลขชั้นกริดจาก comment ที่ลงท้ายด้วย "-M<เลขล้วน>" เท่านั้น (เช่น "-M3")
         // ยอมรับเฉพาะกรณีตัวอักษรหลัง "-M" เป็นเลขล้วนทั้งหมด กันจับผิดจาก comment อื่น
         // ที่บังเอิญมี "-M" ปนอยู่ (เช่นถ้า InpOrderComment ถูกตั้งค่าเป็นคำที่มี "-M")
         int searchPos = 0;
         int foundPos  = -1;
         while(true)
           {
            int p = StringFind(cmt, "-M", searchPos);
            if(p < 0) break;
            foundPos  = p;
            searchPos = p + 1;
           }
         if(foundPos >= 0)
           {
            string levelStr  = StringSubstr(cmt, foundPos + 2);
            bool   allDigits = (StringLen(levelStr) > 0);
            for(int c = 0; c < StringLen(levelStr) && allDigits; c++)
              {
               ushort ch = StringGetCharacter(levelStr, c);
               if(ch < '0' || ch > '9') allDigits = false;
              }
            if(allDigits)
              {
               int lvl = (int)StringToInteger(levelStr);
               if(lvl > maxGridLevel) maxGridLevel = lvl;
              }
           }

         datetime t = (datetime)PositionGetInteger(POSITION_TIME);
         if(newestTicket == 0 || t > newestTime)
           {
            newestTime      = t;
            newestTicket    = ticket;
            newestFillPrice = PositionGetDouble(POSITION_PRICE_OPEN);
           }
         if(oldestTime == 0 || t < oldestTime)
            oldestTime = t;

         double slHere = PositionGetDouble(POSITION_SL);
         if(slHere > 0 && slFromOriginal == 0.0)
            slFromOriginal = slHere;
        }

      if(newestTicket == 0)
         continue; // แทบเป็นไปไม่ได้ (เพิ่ง scan เจอ comment ตรงมาก่อนหน้านี้แล้ว) กันไว้เฉย ๆ

      // v1.24: กู้ realizedProfit จาก History deals ที่ comment ขึ้นต้นด้วย basketId
      // เดียวกัน (ครอบคลุมกำไรที่ Pair-Close เคยล็อกไปแล้วก่อน EA reload) จำกัดช่วงเวลา
      // query แค่ตั้งแต่ไม้เก่าสุดของ basket นี้เปิด (ลบ margin กันเผื่อ 1 นาที) ถึง
      // ปัจจุบัน กันสแกน History ทั้งบัญชีโดยไม่จำเป็น
      double recoveredRealized = 0.0;
      datetime histFrom = (oldestTime > 60) ? (oldestTime - 60) : 0;
      datetime histTo   = TimeCurrent() + 3600;
      if(HistorySelect(histFrom, histTo))
        {
         int totalDeals = HistoryDealsTotal();
         for(int d = 0; d < totalDeals; d++)
           {
            ulong dticket = HistoryDealGetTicket(d);
            if(dticket == 0) continue;
            if(HistoryDealGetInteger(dticket, DEAL_MAGIC) != InpMagic) continue;
            if(HistoryDealGetString(dticket, DEAL_SYMBOL) != _Symbol) continue;
            string dcmt = HistoryDealGetString(dticket, DEAL_COMMENT);
            if(StringFind(dcmt, basketId) != 0) continue;
            if((ENUM_DEAL_ENTRY)HistoryDealGetInteger(dticket, DEAL_ENTRY) != DEAL_ENTRY_OUT) continue; // เฉพาะฝั่งปิด (กำไรที่ realize จริงแล้ว)
            recoveredRealized += HistoryDealGetDouble(dticket, DEAL_PROFIT)
                               + HistoryDealGetDouble(dticket, DEAL_SWAP)
                               + HistoryDealGetDouble(dticket, DEAL_COMMISSION);
           }
        }

      double nextTrig;
      if(isBuy)
         nextTrig = newestFillPrice - InpMartingaleGapUSD;
      else
         nextTrig = newestFillPrice + InpMartingaleGapUSD;

      int idx = ArraySize(g_baskets);
      ArrayResize(g_baskets, idx + 1);
      g_baskets[idx].active                  = true;
      g_baskets[idx].isBuy                   = isBuy;
      g_baskets[idx].basketId                = basketId;
      g_baskets[idx].slPrice                 = slFromOriginal; // เก็บไว้อ้างอิงเฉย ๆ (ไม่ได้ใช้คำนวณ trigger อีกต่อไปตั้งแต่ v1.20)
      g_baskets[idx].baseLot                 = InpLotTotal;
      g_baskets[idx].gridLevel               = maxGridLevel;
      g_baskets[idx].nextTriggerPrice        = nextTrig;
      g_baskets[idx].realizedProfit          = recoveredRealized;
      g_baskets[idx].pendingReplacement      = false;
      g_baskets[idx].pendingIsBuy            = isBuy;
      g_baskets[idx].pendingLot              = 0.0;
      g_baskets[idx].pendingFirstAttemptTick = 0;
      g_baskets[idx].pendingLastAlertTick    = 0;

      recoveredCount++;

      Print("BTW_Signal_EA: [RECOVERY] กู้คืน Basket=", basketId,
            " Dir=", (isBuy ? "BUY" : "SELL"),
            " gridLevel=", maxGridLevel,
            " nextTrigger=", DoubleToString(nextTrig, _Digits),
            " realizedProfit(กู้จาก History)=", DoubleToString(recoveredRealized, 2),
            " USD — EA เพิ่งเริ่ม/reload ใหม่ แต่เจอไม้ค้างอยู่จริงในตลาด กลับมาดูแลต่อทันที");
     }

   if(recoveredCount > 0)
      Print("BTW_Signal_EA: [RECOVERY] กู้คืน basket ที่ค้างอยู่จริงในตลาดสำเร็จทั้งหมด ", recoveredCount, " ชุด");
  }

//+------------------------------------------------------------------+
//| ลงทะเบียน basket ใหม่สำหรับสัญญาณที่เพิ่งเปิดออเดอร์ไป             |
//+------------------------------------------------------------------+
void RegisterBasket(bool isBuy, const string basketId, double slPrice)
  {
   int idx = ArraySize(g_baskets);
   ArrayResize(g_baskets, idx + 1);
   g_baskets[idx].active           = true;
   g_baskets[idx].isBuy            = isBuy;
   g_baskets[idx].basketId         = basketId;
   g_baskets[idx].slPrice          = slPrice;
   g_baskets[idx].baseLot          = InpLotTotal;
   g_baskets[idx].gridLevel        = 0;
   g_baskets[idx].nextTriggerPrice = slPrice; // ไม้แก้ชั้น 1 เปิดที่ SL เดิมพอดี (จุดเริ่มต้น ยังไม่มีไม้ก่อนหน้าให้อ้างอิงราคาจริง)

   // v1.20: ตั้งค่าเริ่มต้นของ realizedProfit + pending replacement state ให้สะอาดทุกครั้งที่เปิด basket ใหม่
   g_baskets[idx].realizedProfit         = 0.0;
   g_baskets[idx].pendingReplacement     = false;
   g_baskets[idx].pendingIsBuy           = isBuy;
   g_baskets[idx].pendingLot             = 0.0;
   g_baskets[idx].pendingFirstAttemptTick= 0;
   g_baskets[idx].pendingLastAlertTick   = 0;

   Print("BTW_Signal_EA: ลงทะเบียน Martingale Basket=", basketId,
         " Dir=", (isBuy ? "BUY" : "SELL"), " SL=", slPrice);
  }

//+------------------------------------------------------------------+
//| อัปเดตสถานะ active ของทุก basket (เช็คว่าไม่มีไม้เหลือแล้วหรือยัง)  |
//| ฟังก์ชันนี้ต้องรันทุก tick เสมอ ไม่ว่าจะเปิดมาร์ติงเกลหรือไม่ก็ตาม   |
//| เพราะใช้เป็นฐานในการนับจำนวน basket ที่ยังเปิดอยู่ (สำหรับ           |
//| InpMaxConcurrentBaskets) แม้ไม่ได้เปิดมาร์ติงเกลเลยก็ต้องรู้ว่า      |
//| basket ไหนปิดหมดแล้วบ้าง                                          |
//+------------------------------------------------------------------+
void UpdateBasketLifecycle()
  {
   for(int i = ArraySize(g_baskets) - 1; i >= 0; i--)
     {
      if(!g_baskets[i].active)
         continue;
      // v1.20: ถ้ายังมีไม้ทดแทน (pending replacement) ค้างรอเปิดอยู่ ห้ามตัดสินว่า
      // basket จบแล้วแม้ไม้จริงในตลาดตอนนี้จะเหลือ 0 ตัวก็ตาม เพราะยังมีภาระต้อง
      // เปิดไม้อยู่ ต้องรอให้ pending resolve (เปิดสำเร็จ) ก่อนถึงจะประเมินใหม่อีกที
      if(CountBasketOpenPositions(g_baskets[i].basketId) == 0 && !g_baskets[i].pendingReplacement)
        {
         g_baskets[i].active = false;
         SaveAllGridLevelsToFile(); // v1.25: rewrite ไฟล์ทันที กัน basket ที่จบแล้วเหลือเป็นเศษค้างในไฟล์นาน
        }
     }
  }

//+------------------------------------------------------------------+
//| นับจำนวน basket ที่ยังมีไม้เปิดอยู่ตอนนี้ (ใช้จำกัดจำนวนชุดพร้อมกัน)|
//+------------------------------------------------------------------+
int CountActiveBaskets()
  {
   int c = 0;
   for(int i = 0; i < ArraySize(g_baskets); i++)
      if(g_baskets[i].active)
         c++;
   return c;
  }

//+------------------------------------------------------------------+
//| ดูแลระบบมาร์ติงเกลทุก basket ที่ active อยู่ (เรียกทุก tick)        |
//+------------------------------------------------------------------+
void ManageMartingale()
  {
   if(!InpMartingaleEnabled)
      return;

   double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);

   for(int i = ArraySize(g_baskets) - 1; i >= 0; i--)
     {
      if(!g_baskets[i].active)
         continue;

      // 1) เช็คก่อนเสมอว่าราคาแตะจุดเปิดไม้แก้ชั้นถัดไปหรือยัง (ก่อนเช็คว่าไม้เหลือ
      //    หรือไม่) เพราะไม้เดิม (TP1+TP2 ที่ใช้ SL ราคาเดียวกัน) อาจเพิ่งถูกปิด
      //    พร้อมกันไปแล้วโดย broker พอดีตอนราคาแตะ SL ถ้าไปเช็ค "ไม่มีไม้เหลือ"
      //    ก่อน จะเข้าใจผิดว่า basket จบแล้ว ทั้งที่ควรเปิดไม้แก้ตรงจุดนั้นพอดี
      if(g_baskets[i].gridLevel < InpMartingaleMaxLevels)
        {
         bool triggered;
         if(g_baskets[i].isBuy)
            triggered = (bid <= g_baskets[i].nextTriggerPrice);
         else
            triggered = (ask >= g_baskets[i].nextTriggerPrice);

         if(triggered)
            OpenMartingaleOrder(g_baskets[i]);
        }

      int openCount = CountBasketOpenPositions(g_baskets[i].basketId);

      // 2) เช็คปิดกำไรด่วน เฉพาะชุดที่ถูกแก้ไม้ไปแล้วอย่างน้อย 1 ชั้น และยังมีไม้เปิดอยู่
      // v1.20: รวม realizedProfit (กำไรที่ Pair-Close ล็อกไปแล้วก่อนหน้า) เข้ากับ
      // floating profit ปัจจุบันด้วย ไม่ใช่นับแค่ไม้ที่ยังเปิดอยู่ตอนนี้เหมือนเดิม
      // เพราะของเดิมทำให้กำไรที่ล็อกไปแล้วหายไปจากสมการ ทำให้ปิดทั้งชุดยากกว่าที่ควร
      if(g_baskets[i].gridLevel > 0 && openCount > 0)
        {
         double floatingProfit = GetBasketFloatingProfit(g_baskets[i].basketId) + g_baskets[i].realizedProfit;
         if(floatingProfit >= InpMartingaleCloseProfitUSD)
           {
            Print("BTW_Signal_EA: Basket=", g_baskets[i].basketId,
                  " ปิดกำไรด่วน floating+realized=", floatingProfit, " USD (เป้า=", InpMartingaleCloseProfitUSD, ")");
            CloseBasketPositions(g_baskets[i].basketId);
            g_baskets[i].active = false;
            // v1.20: ยกเลิก pending replacement ใด ๆ ที่อาจค้างอยู่ เพราะตัดสินใจจบ basket
            // นี้แล้วโดยเจตนา ไม่ต้องการให้มีไม้ใหม่โผล่มาเปิดทีหลังอีก
            g_baskets[i].pendingReplacement = false;
            SaveAllGridLevelsToFile(); // v1.25: rewrite ไฟล์ทันที กัน basket ที่จบแล้วเหลือเป็นเศษค้างในไฟล์นาน
            continue;
           }
        }

      // 3) ถ้าไม่มีไม้เหลืออยู่ในชุดนี้แล้ว (ปิดหมดไม่ว่าจะด้วย TP/SL/ปิดกำไรด่วน) เลิกติดตาม
      // v1.20: ต้องไม่มี pending replacement ค้างอยู่ด้วย ไม่งั้นจะตัดจบ basket ก่อนที่
      // ไม้ทดแทนที่รอคิวเปิดอยู่จะได้เปิดจริง (เหมือนกับที่แก้ไว้ใน UpdateBasketLifecycle)
      if(openCount == 0 && !g_baskets[i].pendingReplacement)
        {
         g_baskets[i].active = false;
         SaveAllGridLevelsToFile(); // v1.25: rewrite ไฟล์ทันที กัน basket ที่จบแล้วเหลือเป็นเศษค้างในไฟล์นาน
        }
     }
  }

//+------------------------------------------------------------------+
//| v1.20: อัปเดต nextTriggerPrice จากราคาเปิดจริงของไม้ล่าสุดที่เปิด  |
//| สำเร็จ ± Gap แทนที่จะคำนวณสะสมจาก SL ตั้งต้นตายตัวแบบเดิม          |
//| เรียกใช้ทั้งจากไม้แก้กริดปกติ (OpenMartingaleOrder) และไม้ทดแทนจาก |
//| Pair-Close (ManagePairClose / ProcessPendingReplacement) เพื่อให้  |
//| ระยะห่างของกริดขยับตามสถานการณ์ราคาจริงเสมอ ไม่ห่างออกไปเรื่อย ๆ  |
//| เมื่อ Pair-Close แทรกหลายรอบ                                     |
//+------------------------------------------------------------------+
void UpdateNextTriggerFromFill(MartingaleBasket &b, double fillPrice)
  {
   if(fillPrice <= 0)
      return; // กันค่าผิดปกติ ถ้าดึงราคาจริงไม่ได้เลย ไม่แตะ nextTriggerPrice เดิม

   if(b.isBuy)
      b.nextTriggerPrice = fillPrice - InpMartingaleGapUSD;
   else
      b.nextTriggerPrice = fillPrice + InpMartingaleGapUSD;
  }

//+------------------------------------------------------------------+
//| v1.25: ชื่อไฟล์เก็บ gridLevel ผูกกับ Magic+Symbol ของ EA instance   |
//| นี้โดยเฉพาะ กันชนกันข้าม EA/คู่เงินอื่นที่รันอยู่ในเทอมินอลเดียวกัน  |
//+------------------------------------------------------------------+
string GetGridStateFilePath()
  {
   return "BTW_GridState_" + IntegerToString(InpMagic) + "_" + _Symbol + ".txt";
  }

//+------------------------------------------------------------------+
//| v1.25: เขียนทับไฟล์ gridLevel ทั้งไฟล์ใหม่ทุกครั้ง โดยเขียนเฉพาะ    |
//| basket ที่ active=true ณ ขณะที่เรียกเท่านั้น (basket ที่ปิดไปแล้ว   |
//| จะไม่ถูกเขียนกลับเข้าไฟล์เองโดยอัตโนมัติ ไม่ต้องมีฟังก์ชันลบแยก)    |
//| เก็บแค่ "basketId,gridLevel" เท่านั้น ไม่ใช่ state ทั้งหมดของ        |
//| basket เพราะ field อื่น (isBuy/nextTriggerPrice/realizedProfit)     |
//| กู้คืนได้แม่นยำอยู่แล้วจากการสแกนไม้จริง+History ใน                |
//| RecoverBasketsFromOpenPositions() มีแค่ gridLevel ตัวเดียวที่พัง    |
//| เพราะ comment ถูกตัดที่ ~31 ตัวอักษร (ยืนยันแล้วว่าตัดที่ข้อมูลจริง) |
//+------------------------------------------------------------------+
void SaveAllGridLevelsToFile()
  {
   int handle = FileOpen(GetGridStateFilePath(), FILE_WRITE | FILE_CSV | FILE_ANSI, ',');
   if(handle == INVALID_HANDLE)
     {
      Print("BTW_Signal_EA: [WARNING] เขียนไฟล์ gridLevel state ไม่ได้ (err=", GetLastError(),
            ") — ไม่กระทบการเทรดปัจจุบันเลย แต่ถ้า EA reload ตอนมีไม้แก้หลายชั้นอยู่ ",
            "gridLevel อาจกู้คืนไม่แม่นยำหลัง reload (จะกู้ได้แค่จาก comment ซึ่งอาจถูกตัด)");
      return;
     }

   for(int i = 0; i < ArraySize(g_baskets); i++)
     {
      if(!g_baskets[i].active) continue;
      FileWrite(handle, g_baskets[i].basketId, g_baskets[i].gridLevel);
     }

   FileClose(handle);
  }

//+------------------------------------------------------------------+
//| v1.25: อ่านไฟล์ gridLevel แล้ว override ค่า gridLevel ของ basket ที่ |
//| ตรงกันใน g_baskets[] (ต้องเรียกหลัง RecoverBasketsFromOpenPositions()|
//| เสมอ เพราะต้องมี basket อยู่ใน g_baskets[] ให้ override ก่อนแล้ว)    |
//| basketId ในไฟล์ที่ไม่ตรงกับ basket ไหนใน g_baskets[] เลย (เช่น       |
//| basket นั้นปิดไปแล้วจริง ไม่มีไม้เปิดอยู่ตอนสแกน) จะถูกข้ามเฉย ๆ      |
//| ไม่ error — ไม่ต้องมีขั้นตอนลบไฟล์แยก เพราะรอบถัดไปที่               |
//| SaveAllGridLevelsToFile() ถูกเรียก บรรทัดเก่าที่ inactive จะไม่ถูก   |
//| เขียนกลับเข้าไฟล์เองอัตโนมัติอยู่แล้ว                              |
//+------------------------------------------------------------------+
void LoadGridLevelsFromFile()
  {
   if(!FileIsExist(GetGridStateFilePath()))
      return; // ยังไม่เคยมีไฟล์ (ใช้ EA ครั้งแรก หรือยังไม่เคยมี basket แก้ไม้เลย) ไม่ใช่ error

   int handle = FileOpen(GetGridStateFilePath(), FILE_READ | FILE_CSV | FILE_ANSI, ',');
   if(handle == INVALID_HANDLE)
     {
      Print("BTW_Signal_EA: [WARNING] อ่านไฟล์ gridLevel state ไม่ได้ (err=", GetLastError(), ")");
      return;
     }

   int appliedCount = 0;
   while(!FileIsEnding(handle))
     {
      string basketId = FileReadString(handle);
      if(basketId == "") break;
      int gridLevel = (int)FileReadNumber(handle);

      for(int i = 0; i < ArraySize(g_baskets); i++)
        {
         if(g_baskets[i].basketId == basketId)
           {
            g_baskets[i].gridLevel = gridLevel;
            appliedCount++;
            Print("BTW_Signal_EA: [RECOVERY] gridLevel ของ Basket=", basketId,
                  " กู้คืนจากไฟล์ = ", gridLevel,
                  " (แม่นยำกว่าที่แกะจาก comment เพราะ comment อาจถูกตัดที่ ~31 ตัวอักษรโดย MT5/broker)");
            break;
           }
        }
     }

   FileClose(handle);

   if(appliedCount > 0)
      Print("BTW_Signal_EA: [RECOVERY] อัปเดต gridLevel จากไฟล์สำเร็จรวม ", appliedCount, " basket");
  }

//+------------------------------------------------------------------+
//| เปิดไม้แก้ชั้นถัดไปของ basket ที่ระบุ แล้วเลื่อนจุดเปิดชั้นถัดไป    |
//+------------------------------------------------------------------+
void OpenMartingaleOrder(MartingaleBasket &b)
  {
   // ดึง multiplier ของชั้นนี้ ถ้า list สั้นกว่าชั้นปัจจุบัน ใช้ค่าตัวสุดท้ายซ้ำไปเรื่อย ๆ
   // (เช่นใส่ list แค่ "2" ตัวเดียว จะเท่ากับ x2 ทุกชั้นจนถึง InpMartingaleMaxLevels)
   double mult;
   if(b.gridLevel < ArraySize(g_mtgMultipliers))
      mult = g_mtgMultipliers[b.gridLevel];
   else if(ArraySize(g_mtgMultipliers) > 0)
      mult = g_mtgMultipliers[ArraySize(g_mtgMultipliers) - 1];
   else
      mult = 1.0;

   // ขนาดไม้แก้อิงจาก "Lot ที่ยังเหลือเปิดอยู่จริงในชุดนี้ ณ ขณะนี้" ไม่ใช่ Lot รวม
   // เดิมทั้งก้อนที่ตั้งไว้ตอนแรก เพราะถ้าบางไม้ (เช่น TP1) ปิดกำไรไปแล้วก่อนหน้านี้
   // ควรแก้ไม้ตามสัดส่วนที่ยังเสี่ยงอยู่จริง ไม่ใช่คำนวณจากขนาดสัญญาณเดิมทั้งหมด
   double currentOpenLot = GetBasketOpenLotVolume(b.basketId);
   if(currentOpenLot <= 0)
      currentOpenLot = b.baseLot; // เผื่อกรณีขอบ ๆ ที่ไม่มีไม้เหลือเลย กันไม้แก้ lot=0

   double lot = NormalizeLot(currentOpenLot * mult);

   if(lot <= 0)
     {
      Print("BTW_Signal_EA: Martingale lot คำนวณได้ 0 ข้ามชั้นนี้ (basket=", b.basketId, ")");

      // v1.20: lot คำนวณได้ 0 ไม่ได้ส่งคำสั่งเลย ไม่มีราคาเปิดจริงให้อ้างอิง
      // ยังคงเลื่อนชั้น+ขยับ trigger ตาม Gap แบบเดิม กันค้างพยายามที่ราคาเดิมตลอดไป
      b.gridLevel++;
      if(b.isBuy)
         b.nextTriggerPrice -= InpMartingaleGapUSD;
      else
         b.nextTriggerPrice += InpMartingaleGapUSD;
     }
   else
     {
      string cmt = b.basketId + "|" + InpOrderComment + "-M" + IntegerToString(b.gridLevel + 1);
      bool ok;
      // ไม้แก้ไม่ตั้ง SL/TP เดี่ยว เพราะปิดรวมทั้งชุดด้วยเป้ากำไรของ basket แทน
      if(b.isBuy)
         ok = trade.Buy(lot, _Symbol, 0, 0, 0, cmt);
      else
         ok = trade.Sell(lot, _Symbol, 0, 0, 0, cmt);

      if(ok)
        {
         // v1.20: ดึงราคาเปิดจริงจากผลลัพธ์คำสั่ง ถ้าดึงไม่ได้ fallback เป็นราคาตลาดปัจจุบัน
         double fillPrice = trade.ResultPrice();
         if(fillPrice <= 0)
            fillPrice = b.isBuy ? SymbolInfoDouble(_Symbol, SYMBOL_ASK) : SymbolInfoDouble(_Symbol, SYMBOL_BID);

         Print("BTW_Signal_EA: เปิดไม้แก้ basket=", b.basketId,
               " ชั้น=", (b.gridLevel + 1), " lot=", lot, " (openLot=", currentOpenLot, " x", mult, ")",
               " @", DoubleToString(fillPrice, _Digits), " (trigger เดิม=", DoubleToString(b.nextTriggerPrice, _Digits), ")");

         // v1.20: อัปเดต nextTriggerPrice ของชั้นถัดไปจากราคาเปิดจริงของไม้นี้ ± Gap
         // แทนการคำนวณสะสมจากกริดตายตัวแบบเดิม (เดิม -= Gap จากค่าเดิมเสมอ)
         b.gridLevel++;
         UpdateNextTriggerFromFill(b, fillPrice);
        }
      else
        {
         Print("BTW_Signal_EA: เปิดไม้แก้ล้มเหลว basket=", b.basketId,
               " ชั้น=", (b.gridLevel + 1), " err=", GetLastError());

         // v1.20: เปิดไม้แก้กริดปกติล้มเหลว (คนละกรณีกับไม้ทดแทน Pair-Close ที่มี
         // pending queue รองรับแยกต่างหาก) ยังคงเลื่อนชั้น+ขยับ trigger ตาม Gap แบบเดิม
         b.gridLevel++;
         if(b.isBuy)
            b.nextTriggerPrice -= InpMartingaleGapUSD;
         else
            b.nextTriggerPrice += InpMartingaleGapUSD;
        }
     }

   // v1.25: บันทึก gridLevel ของทุก basket ที่ active อยู่ ณ ขณะนี้ลงไฟล์ ทุกครั้งที่
   // gridLevel ของ basket ใด basket หนึ่งเปลี่ยน (ครอบคลุมทั้ง 3 branch ด้านบน) กัน
   // ปัญหา comment ของ order/position ถูกตัดที่ ~31 ตัวอักษรโดย MT5/broker (ยืนยันแล้ว
   // ว่าตัดที่ข้อมูลจริง ไม่ใช่แค่ตอนแสดงผล) ทำให้ RecoverBasketsFromOpenPositions()
   // แกะ "-M<เลข>" จาก comment ไม่ได้ถ้า basketId+comment ยาวเกินโควต้าไปแล้ว ไฟล์นี้
   // เป็นแหล่งข้อมูล gridLevel ที่แม่นยำกว่า ใช้ override ค่าที่แกะจาก comment ตอน
   // OnInit (ดู LoadGridLevelsFromFile) ไม่ใช่การเขียน state ทั้งหมดของ basket
   SaveAllGridLevelsToFile();
  }

//+------------------------------------------------------------------+
//| v1.20: ดึงไม้ที่ยังเปิดอยู่ทั้งหมดของ basket ที่ระบุ เรียงจาก       |
//| "เก่าสุด -> ใหม่สุด" ตามเวลาเปิดจริง คืนค่า false ถ้ามีไม้ไม่ถึง 2  |
//| ตัว (จับคู่ไม่ได้) ใช้แทน GetOldestAndNewestBasketPositions เดิมที่ |
//| มองเห็นได้แค่ปลายสองข้างของตะกร้าเท่านั้น ทำให้ไม้แก้ที่อยู่ตรงกลาง |
//| ตะกร้า (เช่น M1 ตอนที่มี M2, M3 เกิดขึ้นแล้ว) ไม่มีวันถูกจับคู่ปิด  |
//| ได้เลย ฟังก์ชันใหม่นี้ให้ ManagePairClose ไล่จับคู่ "ไม้ใหม่สุด"    |
//| กับไม้อื่นทุกตัวในตะกร้าได้ ไม่ใช่แค่สองปลายสุด                    |
//| v1.20 (symbol-safety): เพิ่มเช็ค POSITION_SYMBOL ด้วย เป็นเกราะ    |
//| ป้องกันชั้นที่สอง เผื่อวันหนึ่งมีการตั้ง Magic Number ซ้ำกันโดยไม่   |
//| ได้ตั้งใจข้ามคู่เงินในเทอมินอลเดียวกัน (ผู้ใช้ยืนยันว่าปัจจุบันตั้ง  |
//| Magic แยกกันทุกคู่เงินอยู่แล้ว แต่ใส่ไว้เป็นเกราะป้องกันฟรี ไม่มี   |
//| ผลเสียใด ๆ)                                                       |
//+------------------------------------------------------------------+
bool GetBasketOpenTicketsSorted(const string basketId, ulong &tickets[])
  {
   ulong    tmpTickets[];
   datetime tmpTimes[];

   int total = PositionsTotal();
   for(int i = 0; i < total; i++)
     {
      ulong ticket = PositionGetTicket(i);
      if(ticket == 0) continue;
      if(!PositionSelectByTicket(ticket)) continue;
      if(PositionGetInteger(POSITION_MAGIC) != InpMagic) continue;
      if(PositionGetString(POSITION_SYMBOL) != _Symbol) continue; // symbol-safety (ดู comment ด้านบน)
      string cmt = PositionGetString(POSITION_COMMENT);
      if(StringFind(cmt, basketId) != 0) continue;

      int n = ArraySize(tmpTickets);
      ArrayResize(tmpTickets, n + 1);
      ArrayResize(tmpTimes, n + 1);
      tmpTickets[n] = ticket;
      tmpTimes[n]   = (datetime)PositionGetInteger(POSITION_TIME);
     }

   int cnt = ArraySize(tmpTickets);

   // insertion sort เรียงตามเวลาเปิดจริงจากเก่า->ใหม่ (จำนวนไม้ต่อ basket น้อยมาก
   // ในทางปฏิบัติ ไม่ต้องกังวลเรื่อง performance ของ insertion sort)
   for(int a = 1; a < cnt; a++)
     {
      ulong    keyTicket = tmpTickets[a];
      datetime keyTime   = tmpTimes[a];
      int b = a - 1;
      while(b >= 0 && tmpTimes[b] > keyTime)
        {
         tmpTickets[b + 1] = tmpTickets[b];
         tmpTimes[b + 1]   = tmpTimes[b];
         b--;
        }
      tmpTickets[b + 1] = keyTicket;
      tmpTimes[b + 1]   = keyTime;
     }

   ArrayResize(tickets, cnt);
   for(int k = 0; k < cnt; k++)
      tickets[k] = tmpTickets[k];

   return (cnt >= 2);
  }

